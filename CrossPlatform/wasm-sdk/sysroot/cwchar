#pragma once

#include <stddef.h>

namespace std {

inline size_t wcslen(const wchar_t *s) {
    size_t n = 0;
    while (s && s[n] != 0) ++n;
    return n;
}

inline int wmemcmp(const wchar_t *a, const wchar_t *b, size_t n) {
    for (size_t i = 0; i < n; ++i) {
        if (a[i] != b[i]) return (a[i] < b[i]) ? -1 : 1;
    }
    return 0;
}

} // namespace std

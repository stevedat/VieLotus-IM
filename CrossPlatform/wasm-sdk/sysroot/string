#pragma once

#include <stddef.h>
#include <cstring>

namespace std {

class string {
    static constexpr size_t kMaxLen = 255;
    char m_buf[kMaxLen + 1]{};
    size_t m_len{0};

public:
    string() = default;
    string(const char *s) {
        if (!s) return;
        while (s[m_len] && m_len < kMaxLen) {
            m_buf[m_len] = s[m_len];
            ++m_len;
        }
        m_buf[m_len] = '\0';
    }

    void reserve(size_t) {}
    void clear() {
        m_len = 0;
        m_buf[0] = '\0';
    }
    void push_back(char c) {
        if (m_len < kMaxLen) {
            m_buf[m_len++] = c;
            m_buf[m_len] = '\0';
        }
    }
    size_t size() const { return m_len; }
    bool empty() const { return m_len == 0; }
    const char *c_str() const { return m_buf; }
    const char *data() const { return m_buf; }
    char operator[](size_t i) const { return m_buf[i]; }

    string substr(size_t pos, size_t count) const {
        string r;
        for (size_t i = 0; i < count && pos + i < m_len; ++i) {
            r.push_back(m_buf[pos + i]);
        }
        return r;
    }

    bool operator==(const string &o) const {
        return m_len == o.m_len && (m_len == 0 || memcmp(m_buf, o.m_buf, m_len) == 0);
    }
    bool operator!=(const string &o) const { return !(*this == o); }
};

template <typename A, typename B>
struct pair {
    A first;
    B second;
};

} // namespace std

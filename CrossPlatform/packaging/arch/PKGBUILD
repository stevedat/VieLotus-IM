pkgname=vielotus-bin
_pkgname=vielotus
pkgver=2.0.0
pkgrel=1
pkgdesc="Bộ gõ tiếng Việt Sen Việt (VieLotusIM) thế hệ mới cho Linux (IBus & Fcitx5, Pure Swift 6 Core)"
arch=('x86_64' 'aarch64')
url="https://github.com/stevedat/VieLotus-IM"
license=('MIT')
depends=('glibc' 'gcc-libs' 'glib2' 'python' 'python-gobject' 'gtk3')
optdepends=(
    'fcitx5: Fcitx5 input method framework support'
    'ibus: IBus input method framework support'
)
provides=('vielotus' 'fcitx5-vielotus' 'ibus-vielotus')
conflicts=('vielotus' 'fcitx5-vielotus' 'ibus-vielotus')
source_x86_64=("${_pkgname}_${pkgver}_amd64.deb::https://github.com/stevedat/VieLotus-IM/releases/download/v${pkgver}/${_pkgname}_${pkgver}_amd64.deb")
source_aarch64=("${_pkgname}_${pkgver}_arm64.deb::https://github.com/stevedat/VieLotus-IM/releases/download/v${pkgver}/${_pkgname}_${pkgver}_arm64.deb")
sha256sums_x86_64=('2d8675ee01fe07dc8822a83d9786cf56b303769a71b9578e669a16db1df9028a')
sha256sums_aarch64=('ff7e4b67507da7730aa27571b25ea41e9b2829d3638e2d7489fcb3c68a1f23cd')

package() {
    bsdtar -xf "${srcdir}/data.tar.xz" -C "${pkgdir}/"
}

#!/bin/sh
set -e
if command -v ldconfig >/dev/null 2>&1; then
    ldconfig >/dev/null 2>&1 || true
fi
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi
if command -v ibus >/dev/null 2>&1; then
    ibus write-cache --system >/dev/null 2>&1 || true
fi
# Stop any older running ibus-engine-vielotus daemon so IBus respawns the updated v2.0.0 binary immediately
if command -v pkill >/dev/null 2>&1; then
    pkill -9 -f ibus-engine-vielotus >/dev/null 2>&1 || true
fi

# Register Sen Việt (vielotus) into Ubuntu Language Support (language-selector-common)
PKG_DEPENDS="/usr/share/language-selector/data/pkg_depends"
if [ -f "${PKG_DEPENDS}" ]; then
    if ! grep -q "im:vi::vielotus" "${PKG_DEPENDS}" 2>/dev/null; then
        printf "\n# Sen Việt (VieLotusIM) Vietnamese Input Method\nim:vi::vielotus\nim:vi:fcitx5:fcitx5-vielotus\nim:vi:ibus:ibus-vielotus\n" >> "${PKG_DEPENDS}" || true
    fi
fi

# Auto-register Sen Việt into the active desktop user's Fcitx5 and GNOME/IBus session
TARGET_USER="${SUDO_USER:-}"
if [ -z "${TARGET_USER}" ] && [ -n "${PKEXEC_UID:-}" ]; then
    TARGET_USER=$(id -nu "${PKEXEC_UID}" 2>/dev/null || true)
fi
if [ -z "${TARGET_USER}" ]; then
    TARGET_USER=$(who 2>/dev/null | awk '{print $1; exit}' || true)
fi
if [ -n "${TARGET_USER}" ] && [ "${TARGET_USER}" != "root" ] && [ -x /usr/bin/vielotus-settings ]; then
    TARGET_UID=$(id -u "${TARGET_USER}" 2>/dev/null || true)
    if [ -n "${TARGET_UID}" ] && [ -S "/run/user/${TARGET_UID}/bus" ]; then
        su - "${TARGET_USER}" -c "XDG_RUNTIME_DIR=/run/user/${TARGET_UID} DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${TARGET_UID}/bus /usr/bin/vielotus-settings --activate" >/dev/null 2>&1 || true
    else
        su - "${TARGET_USER}" -c "/usr/bin/vielotus-settings --activate" >/dev/null 2>&1 || true
    fi
fi
exit 0

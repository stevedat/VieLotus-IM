import os, subprocess, sys
import tkinter as tk
from tkinter import ttk

config_path = sys.argv[1]
cfg = {
    "INPUT_METHOD": "telex",
    "GRAMMAR_PROFILE": "sen_flex",
    "SMART_BILINGUAL": "true",
    "MODERN_ORTHOGRAPHY": "true",
    "QUICK_TELEX": "false",
    "RELAXED_CODA": "false",
    "MACRO_ENABLED": "true",
    "DEVELOPER_MODE": "false",
    "PREEDIT_UNDERLINE": "false",
}
if os.path.exists(config_path):
    with open(config_path, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.strip().split("=", 1)
                cfg[k.strip()] = v.strip().strip('"').strip("'")

root = tk.Tk()
root.title("Sen Việt (VieLotusIM v2.0.3) — Cài đặt")
root.geometry("460x320")
root.resizable(False, False)

im_var = tk.StringVar(value=cfg.get("INPUT_METHOD", "telex"))
qt_var = tk.BooleanVar(value=cfg.get("QUICK_TELEX", "false") == "true")
rc_var = tk.BooleanVar(value=cfg.get("RELAXED_CODA", "false") == "true")
mc_var = tk.BooleanVar(value=cfg.get("MACRO_ENABLED", "true") == "true")
dv_var = tk.BooleanVar(value=cfg.get("DEVELOPER_MODE", "false") == "true")

def apply_changes(*_):
    cfg["INPUT_METHOD"] = im_var.get()
    cfg["QUICK_TELEX"] = "true" if qt_var.get() else "false"
    cfg["RELAXED_CODA"] = "true" if rc_var.get() else "false"
    cfg["MACRO_ENABLED"] = "true" if mc_var.get() else "false"
    cfg["DEVELOPER_MODE"] = "true" if dv_var.get() else "false"
    os.makedirs(os.path.dirname(config_path), exist_ok=True)
    with open(config_path, "w", encoding="utf-8") as f:
        for k, v in cfg.items():
            f.write(f'{k}="{v}"\n')
    im_flag = "--vni" if cfg["INPUT_METHOD"] == "vni" else "--telex"
    subprocess.Popen(["/usr/bin/vielotus-settings", im_flag], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

frm = ttk.Frame(root, padding=16)

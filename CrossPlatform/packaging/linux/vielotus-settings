def load_app_rules():
    rules = []
    if os.path.exists(typing_modes_path):
        with open(typing_modes_path, "r", encoding="utf-8", errors="ignore") as rf:
            for raw_ln in rf:
                ln = raw_ln.split("#", 1)[0].strip()
                if not ln or ":" not in ln:
                    continue
                pat, mode_raw = ln.split(":", 1)
                pat = pat.strip().strip('"').strip("'")
                mode_norm = mode_raw.strip().strip('"').strip("'")
                low = mode_norm.lower()
                if low == "passthrough":
                    mode_norm = "passthrough"
                elif low in ("directreplacement", "direct_replacement", "direct"):
                    mode_norm = "directReplacement"
                elif low in ("markedtext", "marked_text", "preedit"):
                    mode_norm = "markedText"
                elif low in ("automatic", "auto"):
                    mode_norm = "automatic"
                else:
                    continue
                if pat:
                    rules.append([pat, mode_norm])
    return rules


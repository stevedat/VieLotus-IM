#!/bin/bash
# ==============================================================================
# Sen Việt (VieLotusIM) — Linux Desktop Settings, Macro/App Rules & Doctor Utility
# Supports both Fcitx5 (fcitx5-configtool) and IBus (GNOME Input Sources)
# License: MIT / Expat (100% Clean-Room Native Implementation)
# ==============================================================================

UID_CUR="$(id -u 2>/dev/null || echo 1000)"
HOME_DIR="${HOME:-}"
if [ -z "${HOME_DIR}" ] && command -v getent >/dev/null 2>&1; then
    HOME_DIR="$(getent passwd "${UID_CUR}" 2>/dev/null | cut -d: -f6 || true)"
fi
CONFIG_ROOT="${XDG_CONFIG_HOME:-${HOME_DIR}/.config}"
DATA_ROOT="${XDG_DATA_HOME:-${HOME_DIR}/.local/share}"
CONFIG_DIR="${CONFIG_ROOT}/vielotus"
TMP_CONFIG_DIR=""
mkdir -p -m 0700 "${CONFIG_DIR}" 2>/dev/null || true
if [ ! -d "${CONFIG_DIR}" ] || [ ! -w "${CONFIG_DIR}" ]; then
    TMP_CONFIG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/vielotus-cfg.XXXXXXXX")"
    chmod 0700 "${TMP_CONFIG_DIR}"
    CONFIG_DIR="${TMP_CONFIG_DIR}"
    trap 'rm -rf "${TMP_CONFIG_DIR}"' EXIT HUP INT TERM
fi
CONFIG_FILE="${CONFIG_DIR}/config.env"
MACROS_FILE="${CONFIG_DIR}/macros.json"
TYPING_MODES_FILE="${CONFIG_DIR}/typing-modes.yml"
LOG_FILE="${CONFIG_DIR}/settings.log"

INPUT_METHOD="telex"
GRAMMAR_PROFILE="classic"
SMART_BILINGUAL="true"
MODERN_ORTHOGRAPHY="true"
QUICK_TELEX="false"
RELAXED_CODA="false"
MACRO_ENABLED="false"
DEVELOPER_MODE="false"
PREEDIT_UNDERLINE="false"

load_config() {
    if [ ! -f "${CONFIG_FILE}" ]; then
        return 0
    fi
    while IFS='=' read -r raw_key raw_val || [ -n "${raw_key}" ]; do
        key=$(printf '%s' "${raw_key}" | tr -d '[:space:]')
        case "${key}" in
            ''|\#*) continue ;;
        esac
        val=$(printf '%s' "${raw_val}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
        case "${key}" in
            INPUT_METHOD)
                case "${val}" in
                    vni|VNI) INPUT_METHOD="vni" ;;
                    *) INPUT_METHOD="telex" ;;
                esac
                ;;
            GRAMMAR_PROFILE)
                case "${val}" in
                    sen_flex|SenFlex|SEN_FLEX|senflex|SENFLEX) GRAMMAR_PROFILE="sen_flex" ;;
                    *) GRAMMAR_PROFILE="classic" ;;
                esac
                ;;
            SMART_BILINGUAL)
                case "${val}" in
                    false|False|FALSE|0) SMART_BILINGUAL="false" ;;
                    *) SMART_BILINGUAL="true" ;;
                esac
                ;;
            MODERN_ORTHOGRAPHY)
                case "${val}" in
                    false|False|FALSE|0) MODERN_ORTHOGRAPHY="false" ;;
                    *) MODERN_ORTHOGRAPHY="true" ;;
                esac
                ;;
            QUICK_TELEX)
                case "${val}" in
                    true|True|TRUE|1) QUICK_TELEX="true" ;;
                    *) QUICK_TELEX="false" ;;
                esac
                ;;
            RELAXED_CODA)
                case "${val}" in
                    true|True|TRUE|1) RELAXED_CODA="true" ;;
                    *) RELAXED_CODA="false" ;;
                esac
                ;;
            MACRO_ENABLED)
                case "${val}" in
                    true|True|TRUE|1) MACRO_ENABLED="true" ;;
                    *) MACRO_ENABLED="false" ;;
                esac
                ;;
            DEVELOPER_MODE)
                case "${val}" in
                    true|True|TRUE|1) DEVELOPER_MODE="true" ;;
                    *) DEVELOPER_MODE="false" ;;
                esac
                ;;
            PREEDIT_UNDERLINE)
                case "${val}" in
                    true|True|TRUE|1) PREEDIT_UNDERLINE="true" ;;
                    *) PREEDIT_UNDERLINE="false" ;;
                esac
                ;;
        esac
    done < "${CONFIG_FILE}"
}

merge_save_config_env() {
    mkdir -p -m 0700 "${CONFIG_DIR}" 2>/dev/null || true
    if command -v python3 >/dev/null 2>&1; then
        python3 - "${CONFIG_FILE}" \
            "${INPUT_METHOD}" \
            "${GRAMMAR_PROFILE}" \
            "${SMART_BILINGUAL}" \
            "${MODERN_ORTHOGRAPHY}" \
            "${QUICK_TELEX}" \
            "${RELAXED_CODA}" \
            "${MACRO_ENABLED}" \
            "${DEVELOPER_MODE}" \
            "${PREEDIT_UNDERLINE}" <<'MERGE_PYEOF'
import os, sys, tempfile

cfg_path = sys.argv[1]
ordered_keys = [
    ("INPUT_METHOD", sys.argv[2]),
    ("GRAMMAR_PROFILE", sys.argv[3]),
    ("SMART_BILINGUAL", sys.argv[4]),
    ("MODERN_ORTHOGRAPHY", sys.argv[5]),
    ("QUICK_TELEX", sys.argv[6]),
    ("RELAXED_CODA", sys.argv[7]),
    ("MACRO_ENABLED", sys.argv[8]),
    ("DEVELOPER_MODE", sys.argv[9]),
    ("PREEDIT_UNDERLINE", sys.argv[10]),
]
updates = dict(ordered_keys)
seen = set()
out_lines = []

if os.path.exists(cfg_path):
    with open(cfg_path, "r", encoding="utf-8", errors="replace") as f:
        for raw_line in f:
            stripped = raw_line.lstrip()
            if not stripped or stripped.startswith("#") or "=" not in raw_line:
                out_lines.append(raw_line if raw_line.endswith("\n") else raw_line + "\n")
                continue
            k_part, _ = raw_line.split("=", 1)
            k = k_part.strip()
            if k in updates:
                if k not in seen:
                    out_lines.append(f'{k}="{updates[k]}"\n')
                    seen.add(k)
            else:
                out_lines.append(raw_line if raw_line.endswith("\n") else raw_line + "\n")

for k, v in ordered_keys:
    if k not in seen:
        out_lines.append(f'{k}="{v}"\n')

parent = os.path.dirname(os.path.abspath(cfg_path))
os.makedirs(parent, mode=0o700, exist_ok=True)
fd, tmp_path = tempfile.mkstemp(prefix=".config.env.", dir=parent)
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as tf:
        tf.writelines(out_lines)
        tf.flush()
        os.fsync(tf.fileno())
    os.replace(tmp_path, cfg_path)
except Exception:
    try:
        os.unlink(tmp_path)
    except OSError:
        pass
    raise
MERGE_PYEOF
    else
        TMP_ENV="${CONFIG_FILE}.tmp.$$"
        (
            umask 077
            if [ -f "${CONFIG_FILE}" ]; then
                grep -v -E '^[[:space:]]*(INPUT_METHOD|GRAMMAR_PROFILE|SMART_BILINGUAL|MODERN_ORTHOGRAPHY|QUICK_TELEX|RELAXED_CODA|MACRO_ENABLED|DEVELOPER_MODE|PREEDIT_UNDERLINE)[[:space:]]*=' "${CONFIG_FILE}" > "${TMP_ENV}" 2>/dev/null || : > "${TMP_ENV}"
            else
                : > "${TMP_ENV}"
            fi
            cat <<ENV_EOF >> "${TMP_ENV}"
INPUT_METHOD="${INPUT_METHOD}"
GRAMMAR_PROFILE="${GRAMMAR_PROFILE}"
SMART_BILINGUAL="${SMART_BILINGUAL}"
MODERN_ORTHOGRAPHY="${MODERN_ORTHOGRAPHY}"
QUICK_TELEX="${QUICK_TELEX}"
RELAXED_CODA="${RELAXED_CODA}"
MACRO_ENABLED="${MACRO_ENABLED}"
DEVELOPER_MODE="${DEVELOPER_MODE}"
PREEDIT_UNDERLINE="${PREEDIT_UNDERLINE}"
ENV_EOF
            mv -f "${TMP_ENV}" "${CONFIG_FILE}"
        )
    fi
}

load_config

configure_fcitx5_profile() {
    FCITX_IM="$1"
    ACTIVATE_PROFILE="${2:-0}"
    FCITX_PROFILE_DIR="${CONFIG_ROOT}/fcitx5"
    FCITX_PROFILE="${FCITX_PROFILE_DIR}/profile"
    mkdir -p "${FCITX_PROFILE_DIR}/conf"

    FCITX_GRAMMAR="SenFlex"
    if [ "${GRAMMAR_PROFILE}" = "classic" ]; then
        FCITX_GRAMMAR="Classic"
    fi
    FCITX_SB="True"
    [ "${SMART_BILINGUAL}" = "false" ] && FCITX_SB="False"
    FCITX_MOD="True"
    [ "${MODERN_ORTHOGRAPHY}" = "false" ] && FCITX_MOD="False"
    FCITX_QT="False"
    [ "${QUICK_TELEX}" = "true" ] && FCITX_QT="True"
    FCITX_RC="False"
    [ "${RELAXED_CODA}" = "true" ] && FCITX_RC="True"
    FCITX_MC="True"
    [ "${MACRO_ENABLED}" = "false" ] && FCITX_MC="False"
    FCITX_DM="False"
    [ "${DEVELOPER_MODE}" = "true" ] && FCITX_DM="True"
    FCITX_PU="False"
    [ "${PREEDIT_UNDERLINE}" = "true" ] && FCITX_PU="True"

    cat <<FCITX_CONF_EOF > "${FCITX_PROFILE_DIR}/conf/vielotus.conf"
# Chế độ đặt dấu (Grammar Profile)
GrammarProfile=${FCITX_GRAMMAR}
# Song ngữ thông minh Anh-Việt (Smart Bilingual)
SmartBilingual=${FCITX_SB}
# Chính tả hiện đại: oà, uý (thay vì òa, úy)
ModernOrthography=${FCITX_MOD}
# Gõ tắt phụ âm đầu (Quick Telex: cc=ch, gg=gi, kk=kh...)
QuickTelex=${FCITX_QT}
# Gõ tắt phụ âm cuối (Relaxed Coda: -g=-ng, -h=-nh, -k=-ch)
RelaxedCoda=${FCITX_RC}
# Bảng gõ tắt thông minh (Macro Expansion)
MacroEnabled=${FCITX_MC}
# Chế độ Nhà phát triển (tạm ngắt dấu trong khối code)
DeveloperMode=${FCITX_DM}
# Hiện gạch chân khi đang gõ dấu (Preedit Underline)
PreeditUnderline=${FCITX_PU}
FCITX_CONF_EOF

    if [ "${ACTIVATE_PROFILE}" = "1" ] && [ -f "${FCITX_PROFILE}" ] && command -v python3 >/dev/null 2>&1; then
        python3 - "${FCITX_PROFILE}" "${FCITX_IM}" <<'PYEOF' 2>/dev/null || true
import re, sys

profile_path, im_name = sys.argv[1], sys.argv[2]
with open(profile_path, "r", encoding="utf-8", errors="ignore") as f:
    text = f.read()

if re.search(r"^Name=vielotus-(telex|vni)$", text, flags=re.M):
    text = re.sub(r"^Name=vielotus-(telex|vni)$", f"Name={im_name}", text, count=1, flags=re.M)
    text = re.sub(r"^DefaultIM=.*$", f"DefaultIM={im_name}", text, count=1, flags=re.M)
    with open(profile_path, "w", encoding="utf-8") as f:
        f.write(text)
elif "[Groups/0]" in text:
    indices = [int(m) for m in re.findall(r"^\[Groups/0/Items/(\d+)\]", text, flags=re.M)]
    next_idx = (max(indices) + 1) if indices else 0
    new_item = f"\n[Groups/0/Items/{next_idx}]\nName={im_name}\nLayout=\n"
    text = re.sub(r"^DefaultIM=.*$", f"DefaultIM={im_name}", text, count=1, flags=re.M)
    if "[GroupOrder]" in text:
        text = text.replace("[GroupOrder]", new_item.lstrip("\n") + "\n[GroupOrder]", 1)
    else:
        text = text.rstrip() + "\n" + new_item
    with open(profile_path, "w", encoding="utf-8") as f:
        f.write(text)
PYEOF
    fi
}

IBUS_WAS_RELOADED=0

discover_live_ibus_address() {
    [ -d "${CONFIG_ROOT}/ibus/bus" ] || return 0
    for bfile in $(ls -1t "${CONFIG_ROOT}/ibus/bus"/* 2>/dev/null); do
        [ -f "${bfile}" ] || continue
        b_pid=$(sed -n 's/^IBUS_DAEMON_PID=//p' "${bfile}" 2>/dev/null | tr -d "\"'[:space:]")
        b_addr=$(sed -n 's/^IBUS_ADDRESS=//p' "${bfile}" 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
        if [ -n "${b_pid}" ] && [ -n "${b_addr}" ] && kill -0 "${b_pid}" 2>/dev/null; then
            export IBUS_ADDRESS="${b_addr}"
            return 0
        fi
    done
    return 0
}

reload_live_ibus_if_needed() {
    IBUS_WAS_RELOADED=0
    command -v ibus >/dev/null 2>&1 || return 0
    rm -f "${HOME_DIR}/.cache/ibus/bus/registry"* 2>/dev/null || true
    ibus write-cache >/dev/null 2>&1 || true
    pgrep -x ibus-daemon >/dev/null 2>&1 || return 0
    discover_live_ibus_address
    if ibus list-engine 2>/dev/null | grep -q "vielotus"; then
        return 0
    fi
    # Live ibus-daemon has not loaded /usr/share/ibus/component/vielotus.xml into RAM yet.
    # Reload cleanly via user systemd unit (if active) or direct IBus D-Bus restart.
    if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet org.freedesktop.IBus.session.GNOME.service 2>/dev/null; then
        systemctl --user restart org.freedesktop.IBus.session.GNOME.service >/dev/null 2>&1 || true
        sleep 0.35
        discover_live_ibus_address
    fi
    if ! ibus list-engine 2>/dev/null | grep -q "vielotus"; then
        ibus restart --type=direct >/dev/null 2>&1 || ibus restart >/dev/null 2>&1 || true
    fi
    i=0
    while [ "${i}" -lt 12 ]; do
        sleep 0.25
        discover_live_ibus_address
        if ibus list-engine 2>/dev/null | grep -q "vielotus"; then
            IBUS_WAS_RELOADED=1
            # Give GNOME Shell IBusManager time to finish list_engines_async() before rebinding sources
            sleep 0.35
            return 0
        fi
        i=$((i + 1))
    done
    return 0
}

repair_and_sync_gnome_sources() {
    TARGET_ENGINE_ID="${1:-vielotus}"
    REPAIR_ONLY="${2:-0}"
    FORCE_REBIND="${3:-0}"
    if ! command -v gsettings >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
        return 0
    fi
    python3 - "${TARGET_ENGINE_ID}" "${REPAIR_ONLY}" "${FORCE_REBIND}" <<'PYEOF' 2>/dev/null || true
import ast, glob, os, subprocess, sys, time
engine_id = sys.argv[1]
repair_only = sys.argv[2] == "1"
force_rebind = sys.argv[3] == "1"

# Ensure user IBus component cache has the latest '🇻🇳 tex' / '🇻🇳 vni' symbols
ibus_cache_dir = os.path.expanduser("~/.cache/ibus/bus")
cache_refreshed = False
if os.path.isdir(ibus_cache_dir):
    for reg_file in glob.glob(os.path.join(ibus_cache_dir, "registry*")):
        try:
            with open(reg_file, "rb") as rf:
                data = rf.read()
            if b"vielotus" in data and b"\xf0\x9f\x87\xbb\xf0\x9f\x87\xb3 tex" not in data:
                os.unlink(reg_file)
                cache_refreshed = True
        except Exception:
            pass
if cache_refreshed:
    subprocess.call(["ibus", "write-cache"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def get_sources_list(key):
    try:
        raw = subprocess.check_output(
            ["gsettings", "get", "org.gnome.desktop.input-sources", key],
            stderr=subprocess.DEVNULL
        ).decode().strip()
        if raw.startswith("@a(ss) "):
            raw = raw[len("@a(ss) "):]
        return list(ast.literal_eval(raw)) if raw else []
    except Exception:
        return []

def fmt_sources(lst):
    return "[" + ", ".join(f"('{k}', '{v}')" for k, v in lst) + "]"

def set_gsettings(key, val):
    subprocess.call(
        ["gsettings", "set", "org.gnome.desktop.input-sources", key, val],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

sources = get_sources_list("sources")
vl_indices = [i for i, s in enumerate(sources) if s[0] == "ibus" and s[1] in ("vielotus", "vielotus-vni")]
if not vl_indices:
    if repair_only:
        sys.exit(0)
    desk_env = (os.environ.get("XDG_CURRENT_DESKTOP", "") + " " + os.environ.get("DESKTOP_SESSION", "")).lower()
    if not sources and "gnome" not in desk_env and "ubuntu" not in desk_env:
        sys.exit(0)
    new_sources = list(sources) if sources else [("xkb", "us")]
    new_sources.append(("ibus", engine_id))
    vl_indices = [len(new_sources) - 1]
else:
    new_sources = list(sources)
    if len(vl_indices) >= 2:
        # Auto-repair duplicate ('ibus', 'vielotus-vni') / ('ibus', 'vielotus') entries so
        # entry #1 is always Sen Việt - Telex ('vielotus') and entry #2 is Sen Việt - VNI ('vielotus-vni')
        repaired = []
        vl_seen = 0
        for s in sources:
            if s[0] == "ibus" and s[1] in ("vielotus", "vielotus-vni"):
                if vl_seen == 0:
                    repaired.append(("ibus", "vielotus"))
                    vl_seen += 1
                elif vl_seen == 1:
                    repaired.append(("ibus", "vielotus-vni"))
                    vl_seen += 1
            else:
                repaired.append(s)
        new_sources = repaired
    elif not repair_only and len(vl_indices) == 1:
        idx = vl_indices[0]
        new_sources[idx] = ("ibus", engine_id)

if repair_only:
    if new_sources != sources:
        set_gsettings("sources", fmt_sources(new_sources))
    elif (cache_refreshed or force_rebind) and vl_indices:
        without_vl = [s for s in new_sources if not (s[0] == "ibus" and s[1] in ("vielotus", "vielotus-vni"))]
        if not without_vl:
            without_vl = [("xkb", "us")]
        set_gsettings("sources", fmt_sources(without_vl))
        time.sleep(0.15)
        set_gsettings("sources", fmt_sources(new_sources))
    sys.exit(0)

# Update mru-sources so ('ibus', engine_id) is the top-priority active input source
mru = get_sources_list("mru-sources")
target_tuple = ("ibus", engine_id)
base_for_mru = mru if mru else new_sources
new_mru = [target_tuple]
for s in base_for_mru:
    if s != target_tuple and s in new_sources and s not in new_mru:
        new_mru.append(s)
for s in new_sources:
    if s not in new_mru:
        new_mru.append(s)

if force_rebind and vl_indices:
    # Force GNOME Shell & gnome-control-center to drop stale raw IDs ('vielotus') and
    # re-resolve IBusEngineDesc ('Sen Việt - Telex' / '🇻🇳 tex') from reloaded ibus-daemon
    without_vl = [s for s in new_sources if not (s[0] == "ibus" and s[1] in ("vielotus", "vielotus-vni"))]
    if not without_vl:
        without_vl = [("xkb", "us")]
    set_gsettings("sources", fmt_sources(without_vl))
    time.sleep(0.15)
    set_gsettings("sources", fmt_sources(new_sources))
    set_gsettings("mru-sources", fmt_sources(new_mru))
    if target_tuple in new_sources:
        set_gsettings("current", f"uint32 {new_sources.index(target_tuple)}")
    sys.exit(0)

set_gsettings("mru-sources", fmt_sources(new_mru))

if target_tuple in new_sources:
    target_idx = new_sources.index(target_tuple)
    set_gsettings("current", f"uint32 {target_idx}")

if new_sources != sources:
    set_gsettings("sources", fmt_sources(new_sources))
elif len(vl_indices) >= 2 and (not mru or mru[0] != target_tuple):
    # Trigger GNOME Shell _inputSourcesChanged to activate new_mru[0] while keeping both Telex & VNI
    temp_sources = [s for s in new_sources if not (s[0] == "ibus" and s[1] in ("vielotus", "vielotus-vni") and s != target_tuple)]
    set_gsettings("sources", fmt_sources(temp_sources))
    set_gsettings("mru-sources", fmt_sources(new_mru))
    set_gsettings("sources", fmt_sources(new_sources))
PYEOF
}

save_and_apply() {
    MODE="${1:-$INPUT_METHOD}"
    ACTIVATE_SOURCES="${2:-0}"
    FORCE_REBIND_ARG="${3:-0}"
    case "${MODE}" in
        vni|VNI) INPUT_METHOD="vni" ;;
        *) INPUT_METHOD="telex" ;;
    esac

    merge_save_config_env

    ENGINE_ID="vielotus"
    FCITX_IM_ID="vielotus-telex"
    if [ "${INPUT_METHOD}" = "vni" ]; then
        ENGINE_ID="vielotus-vni"
        FCITX_IM_ID="vielotus-vni"
    fi

    # 1. Update Fcitx5 addon config file
    configure_fcitx5_profile "${FCITX_IM_ID}" "${ACTIVATE_SOURCES}" || true

    # Reload/switch Fcitx5 if running
    if command -v fcitx5 >/dev/null 2>&1; then
        if pgrep -x fcitx5 >/dev/null 2>&1 || [ "${XMODIFIERS:-}" = "@im=fcitx" ] || [ "${GTK_IM_MODULE:-}" = "fcitx" ]; then
            if command -v fcitx5-remote >/dev/null 2>&1; then
                fcitx5-remote -r >/dev/null 2>&1 || true
                if [ "${ACTIVATE_SOURCES}" = "1" ]; then
                    fcitx5-remote -s "${FCITX_IM_ID}" >/dev/null 2>&1 || true
                fi
            fi
        fi
    fi

    # 2. Ensure live ibus-daemon has loaded vielotus.xml before binding GNOME Input Sources
    REBIND_FLAG="${FORCE_REBIND_ARG}"
    if [ "${ACTIVATE_SOURCES}" = "1" ] && command -v ibus >/dev/null 2>&1; then
        reload_live_ibus_if_needed
        if [ "${IBUS_WAS_RELOADED:-0}" = "1" ]; then
            REBIND_FLAG="1"
        fi
    fi

    # 3. Repair duplicate GNOME Input Sources and sync active Telex/VNI selection
    if [ "${ACTIVATE_SOURCES}" = "1" ]; then
        repair_and_sync_gnome_sources "${ENGINE_ID}" "0" "${REBIND_FLAG}"
    fi

    # 4. Switch active IBus engine if IBus daemon is reachable and user explicitly changed mode
    if [ "${ACTIVATE_SOURCES}" = "1" ] && command -v ibus >/dev/null 2>&1; then
        if pgrep -x ibus-daemon >/dev/null 2>&1; then
            discover_live_ibus_address
            (ibus engine "${ENGINE_ID}" >/dev/null 2>&1 || true) &
        fi
    fi

    # 5. Sync drop-in fontconfig rules for sandboxed Snap apps (never touches ~/.config/fontconfig/fonts.conf)
    if [ -d /snap ] && [ -f /etc/fonts/conf.d/99-vielotus-vietnamese.conf ]; then
        mkdir -p "${CONFIG_ROOT}/fontconfig/conf.d" 2>/dev/null || true
        if [ -f /etc/fonts/conf.d/51-vielotus-vietnamese.conf ]; then
            cp -f /etc/fonts/conf.d/51-vielotus-vietnamese.conf "${CONFIG_ROOT}/fontconfig/conf.d/51-vielotus-vietnamese.conf" 2>/dev/null || true
        fi
        cp -f /etc/fonts/conf.d/99-vielotus-vietnamese.conf "${CONFIG_ROOT}/fontconfig/conf.d/99-vielotus-vietnamese.conf" 2>/dev/null || true
    fi
}

run_doctor() {
    if command -v python3 >/dev/null 2>&1; then
        python3 - "${CONFIG_FILE}" "${MACROS_FILE}" "${TYPING_MODES_FILE}" <<'DOC_PYEOF'
import glob, json, os, platform, shutil, subprocess, sys

cfg_path, macros_path, modes_path = sys.argv[1], sys.argv[2], sys.argv[3]
warnings = 0
errors = 0

print("✦ === Chẩn đoán Môi trường Sen Việt (VieLotusIM Doctor) ===")
print(f"• Hệ điều hành / Kiến trúc : {platform.system()} {platform.release()} ({platform.machine()})")

session_type = os.environ.get("XDG_SESSION_TYPE", "").strip()
if not session_type:
    if os.environ.get("WAYLAND_DISPLAY"):
        session_type = "wayland"
    elif os.environ.get("DISPLAY"):
        session_type = "x11"

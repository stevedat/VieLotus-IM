ttk.Radiobutton(frm, text="Telex Tự Do (s f r x j w — vieetj → việt)", variable=im_var, value="telex", command=apply_changes).pack(anchor="w")
ttk.Radiobutton(frm, text="VNI Chuẩn (phím số 1–9 — vie65t → việt)", variable=im_var, value="vni", command=apply_changes).pack(anchor="w")
ttk.Separator(frm, orient="horizontal").pack(fill="x", pady=10)
ttk.Checkbutton(frm, text="Gõ tắt phụ âm (Quick Telex: cc=ch, gg=gi, kk=kh)", variable=qt_var, command=apply_changes).pack(anchor="w")
ttk.Checkbutton(frm, text="Phụ âm cuối mở rộng (f, j, w, z)", variable=rc_var, command=apply_changes).pack(anchor="w")
ttk.Checkbutton(frm, text="Gõ tắt thông minh (vn → Việt Nam)", variable=mc_var, command=apply_changes).pack(anchor="w")
ttk.Checkbutton(frm, text="Bảo vệ Code & Terminal (IDE / CLI)", variable=dv_var, command=apply_changes).pack(anchor="w")

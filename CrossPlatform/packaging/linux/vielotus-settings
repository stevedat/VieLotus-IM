#!/bin/bash
# ==============================================================================
# Sen Việt (VieLotusIM) — Linux Desktop Settings Utility
# Supports both Fcitx5 (fcitx5-configtool) and IBus (GNOME Input Sources)
# ==============================================================================

UID_CUR="$(id -u 2>/dev/null || echo 1000)"
HOME_DIR="${HOME:-}"
if [ -z "${HOME_DIR}" ] && command -v getent >/dev/null 2>&1; then
    HOME_DIR="$(getent passwd "${UID_CUR}" 2>/dev/null | cut -d: -f6 || true)"
fi
CONFIG_ROOT="${XDG_CONFIG_HOME:-${HOME_DIR}/.config}"
DATA_ROOT="${XDG_DATA_HOME:-${HOME_DIR}/.local/share}"
CONFIG_DIR="${CONFIG_ROOT}/vielotus"
TMP_CONFIG_DIR=""
mkdir -p -m 0700 "${CONFIG_DIR}" 2>/dev/null || true
if [ ! -d "${CONFIG_DIR}" ] || [ ! -w "${CONFIG_DIR}" ]; then
    TMP_CONFIG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/vielotus-cfg.XXXXXXXX")"
    chmod 0700 "${TMP_CONFIG_DIR}"
    CONFIG_DIR="${TMP_CONFIG_DIR}"
    trap 'rm -rf "${TMP_CONFIG_DIR}"' EXIT HUP INT TERM
fi
CONFIG_FILE="${CONFIG_DIR}/config.env"
LOG_FILE="${CONFIG_DIR}/settings.log"

INPUT_METHOD="telex"
GRAMMAR_PROFILE="sen_flex"
SMART_BILINGUAL="true"
MODERN_ORTHOGRAPHY="true"
QUICK_TELEX="false"
RELAXED_CODA="false"
MACRO_ENABLED="true"
DEVELOPER_MODE="false"
PREEDIT_UNDERLINE="false"

load_config() {
    if [ ! -f "${CONFIG_FILE}" ]; then
        return 0
    fi
    while IFS='=' read -r raw_key raw_val || [ -n "${raw_key}" ]; do
        key=$(printf '%s' "${raw_key}" | tr -d '[:space:]')
        case "${key}" in
            ''|\#*) continue ;;
        esac
        val=$(printf '%s' "${raw_val}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
        case "${key}" in
            INPUT_METHOD)
                case "${val}" in
                    vni|VNI) INPUT_METHOD="vni" ;;
                    *) INPUT_METHOD="telex" ;;
                esac
                ;;
            GRAMMAR_PROFILE)
                case "${val}" in
                    classic|Classic|CLASSIC) GRAMMAR_PROFILE="classic" ;;
                    *) GRAMMAR_PROFILE="sen_flex" ;;
                esac
                ;;
            SMART_BILINGUAL)
                case "${val}" in
                    false|False|FALSE|0) SMART_BILINGUAL="false" ;;
                    *) SMART_BILINGUAL="true" ;;
                esac
                ;;
            MODERN_ORTHOGRAPHY)
                case "${val}" in
                    false|False|FALSE|0) MODERN_ORTHOGRAPHY="false" ;;
                    *) MODERN_ORTHOGRAPHY="true" ;;
                esac
                ;;
            QUICK_TELEX)
                case "${val}" in
                    true|True|TRUE|1) QUICK_TELEX="true" ;;
                    *) QUICK_TELEX="false" ;;
                esac
                ;;
            RELAXED_CODA)
                case "${val}" in
                    true|True|TRUE|1) RELAXED_CODA="true" ;;
                    *) RELAXED_CODA="false" ;;
                esac
                ;;
            MACRO_ENABLED)
                case "${val}" in
                    false|False|FALSE|0) MACRO_ENABLED="false" ;;
                    *) MACRO_ENABLED="true" ;;
                esac
                ;;
            DEVELOPER_MODE)
                case "${val}" in
                    true|True|TRUE|1) DEVELOPER_MODE="true" ;;
                    *) DEVELOPER_MODE="false" ;;
                esac
                ;;
            PREEDIT_UNDERLINE)
                case "${val}" in
                    true|True|TRUE|1) PREEDIT_UNDERLINE="true" ;;
                    *) PREEDIT_UNDERLINE="false" ;;
                esac
                ;;
        esac
    done < "${CONFIG_FILE}"
}

load_config

configure_fcitx5_profile() {
    FCITX_IM="$1"
    ACTIVATE_PROFILE="${2:-0}"
    FCITX_PROFILE_DIR="${CONFIG_ROOT}/fcitx5"
    FCITX_PROFILE="${FCITX_PROFILE_DIR}/profile"
    mkdir -p "${FCITX_PROFILE_DIR}/conf"

    FCITX_GRAMMAR="SenFlex"
    if [ "${GRAMMAR_PROFILE}" = "classic" ]; then
        FCITX_GRAMMAR="Classic"
    fi
    FCITX_SB="True"
    [ "${SMART_BILINGUAL}" = "false" ] && FCITX_SB="False"
    FCITX_MOD="True"
    [ "${MODERN_ORTHOGRAPHY}" = "false" ] && FCITX_MOD="False"
    FCITX_QT="False"
    [ "${QUICK_TELEX}" = "true" ] && FCITX_QT="True"

    cat <<FCITX_CONF_EOF > "${FCITX_PROFILE_DIR}/conf/vielotus.conf"
# Chế độ đặt dấu (Grammar Profile)
GrammarProfile=${FCITX_GRAMMAR}
# Song ngữ thông minh Anh-Việt (Smart Bilingual)
SmartBilingual=${FCITX_SB}
# Chính tả hiện đại: oà, uý (thay vì òa, úy)
ModernOrthography=${FCITX_MOD}
# Gõ tắt phụ âm (Quick Telex: cc=ch, gg=gi, kk=kh...)
QuickTelex=${FCITX_QT}
FCITX_CONF_EOF

    if [ "${ACTIVATE_PROFILE}" = "1" ] && [ -f "${FCITX_PROFILE}" ] && command -v python3 >/dev/null 2>&1; then
        python3 - "${FCITX_PROFILE}" "${FCITX_IM}" <<'PYEOF' 2>/dev/null || true
import re, sys

profile_path, im_name = sys.argv[1], sys.argv[2]
with open(profile_path, "r", encoding="utf-8", errors="ignore") as f:
    text = f.read()

if re.search(r"^Name=vielotus-(telex|vni)$", text, flags=re.M):
    text = re.sub(r"^Name=vielotus-(telex|vni)$", f"Name={im_name}", text, count=1, flags=re.M)
    with open(profile_path, "w", encoding="utf-8") as f:
        f.write(text)
PYEOF
    fi
}

repair_and_sync_gnome_sources() {
    TARGET_ENGINE_ID="${1:-vielotus}"
    REPAIR_ONLY="${2:-0}"
    if ! command -v gsettings >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
        return 0
    fi
    python3 - "${TARGET_ENGINE_ID}" "${REPAIR_ONLY}" <<'PYEOF' 2>/dev/null || true
import ast, glob, os, subprocess, sys
engine_id = sys.argv[1]
repair_only = sys.argv[2] == "1"

# Ensure user IBus component cache has the latest '🇻🇳 tex' / '🇻🇳 vni' symbols
ibus_cache_dir = os.path.expanduser("~/.cache/ibus/bus")
cache_refreshed = False
if os.path.isdir(ibus_cache_dir):
    for reg_file in glob.glob(os.path.join(ibus_cache_dir, "registry*")):
        try:
            with open(reg_file, "rb") as rf:
                data = rf.read()
            if b"vielotus" in data and b"\xf0\x9f\x87\xbb\xf0\x9f\x87\xb3 tex" not in data:
                os.unlink(reg_file)
                cache_refreshed = True
        except Exception:
            pass
if cache_refreshed:
    subprocess.call(["ibus", "write-cache"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def get_sources_list(key):
    try:
        raw = subprocess.check_output(
            ["gsettings", "get", "org.gnome.desktop.input-sources", key],
            stderr=subprocess.DEVNULL
        ).decode().strip()
        if raw.startswith("@a(ss) "):
            raw = raw[len("@a(ss) "):]
        return list(ast.literal_eval(raw)) if raw else []
    except Exception:
        return []

def fmt_sources(lst):
    return "[" + ", ".join(f"('{k}', '{v}')" for k, v in lst) + "]"

def set_gsettings(key, val):
    subprocess.call(
        ["gsettings", "set", "org.gnome.desktop.input-sources", key, val],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

sources = get_sources_list("sources")
vl_indices = [i for i, s in enumerate(sources) if s[0] == "ibus" and s[1] in ("vielotus", "vielotus-vni")]
if not vl_indices:
    sys.exit(0)

new_sources = list(sources)
if len(vl_indices) >= 2:
    # Auto-repair duplicate ('ibus', 'vielotus-vni') / ('ibus', 'vielotus') entries so
    # entry #1 is always Sen Việt - Telex ('vielotus') and entry #2 is Sen Việt - VNI ('vielotus-vni')
    repaired = []
    vl_seen = 0
    for s in sources:
        if s[0] == "ibus" and s[1] in ("vielotus", "vielotus-vni"):
            if vl_seen == 0:
                repaired.append(("ibus", "vielotus"))
                vl_seen += 1
            elif vl_seen == 1:
                repaired.append(("ibus", "vielotus-vni"))
                vl_seen += 1
        else:
            repaired.append(s)
    new_sources = repaired
elif not repair_only and len(vl_indices) == 1:
    idx = vl_indices[0]
    new_sources[idx] = ("ibus", engine_id)

if repair_only:
    if new_sources != sources:
        set_gsettings("sources", fmt_sources(new_sources))
    elif cache_refreshed and len(new_sources) >= 2:
        temp_sources = [s for s in new_sources if s != ("ibus", "vielotus-vni")]
        set_gsettings("sources", fmt_sources(temp_sources))
        set_gsettings("sources", fmt_sources(new_sources))
    sys.exit(0)

# Update mru-sources so ('ibus', engine_id) is the top-priority active input source
mru = get_sources_list("mru-sources")
target_tuple = ("ibus", engine_id)
base_for_mru = mru if mru else new_sources
new_mru = [target_tuple]
for s in base_for_mru:
    if s != target_tuple and s in new_sources and s not in new_mru:
        new_mru.append(s)
for s in new_sources:
    if s not in new_mru:
        new_mru.append(s)
set_gsettings("mru-sources", fmt_sources(new_mru))

if target_tuple in new_sources:
    target_idx = new_sources.index(target_tuple)
    set_gsettings("current", f"uint32 {target_idx}")

if new_sources != sources:
    set_gsettings("sources", fmt_sources(new_sources))
elif len(vl_indices) >= 2 and (not mru or mru[0] != target_tuple):
    # Trigger GNOME Shell _inputSourcesChanged to activate new_mru[0] while keeping both Telex & VNI
    temp_sources = [s for s in new_sources if not (s[0] == "ibus" and s[1] in ("vielotus", "vielotus-vni") and s != target_tuple)]
    set_gsettings("sources", fmt_sources(temp_sources))
    set_gsettings("mru-sources", fmt_sources(new_mru))
    set_gsettings("sources", fmt_sources(new_sources))
PYEOF
}

save_and_apply() {
    MODE="${1:-$INPUT_METHOD}"
    ACTIVATE_SOURCES="${2:-0}"
    case "${MODE}" in
        vni|VNI) INPUT_METHOD="vni" ;;
        *) INPUT_METHOD="telex" ;;
    esac

    cat <<ENV_EOF > "${CONFIG_FILE}"
INPUT_METHOD="${INPUT_METHOD}"
GRAMMAR_PROFILE="${GRAMMAR_PROFILE}"
SMART_BILINGUAL="${SMART_BILINGUAL}"
MODERN_ORTHOGRAPHY="${MODERN_ORTHOGRAPHY}"
QUICK_TELEX="${QUICK_TELEX}"
RELAXED_CODA="${RELAXED_CODA}"
MACRO_ENABLED="${MACRO_ENABLED}"
DEVELOPER_MODE="${DEVELOPER_MODE}"
PREEDIT_UNDERLINE="${PREEDIT_UNDERLINE}"
ENV_EOF

    ENGINE_ID="vielotus"
    FCITX_IM_ID="vielotus-telex"
    if [ "${INPUT_METHOD}" = "vni" ]; then
        ENGINE_ID="vielotus-vni"
        FCITX_IM_ID="vielotus-vni"
    fi

    # 1. Update Fcitx5 addon config file
    configure_fcitx5_profile "${FCITX_IM_ID}" "${ACTIVATE_SOURCES}" || true

    # Reload/switch Fcitx5 if running
    if command -v fcitx5 >/dev/null 2>&1; then
        if pgrep -x fcitx5 >/dev/null 2>&1 || [ "${XMODIFIERS:-}" = "@im=fcitx" ] || [ "${GTK_IM_MODULE:-}" = "fcitx" ]; then
            if command -v fcitx5-remote >/dev/null 2>&1; then
                fcitx5-remote -r >/dev/null 2>&1 || true
                if [ "${ACTIVATE_SOURCES}" = "1" ]; then
                    fcitx5-remote -s "${FCITX_IM_ID}" >/dev/null 2>&1 || true
                fi
            fi
        fi
    fi

    # 2. Switch active IBus engine if IBus daemon is reachable and user explicitly changed mode
    if [ "${ACTIVATE_SOURCES}" = "1" ] && command -v ibus >/dev/null 2>&1; then
        if pgrep -x ibus-daemon >/dev/null 2>&1; then
            (ibus engine "${ENGINE_ID}" >/dev/null 2>&1 || true) &
        fi
    fi

    # 3. Repair duplicate GNOME Input Sources and sync active Telex/VNI selection
    if [ "${ACTIVATE_SOURCES}" = "1" ]; then
        repair_and_sync_gnome_sources "${ENGINE_ID}" "0"
    fi
}


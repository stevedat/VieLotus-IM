def _capture_gtk_window_png(gtk_win, out_path):
    try:
        while Gtk.events_pending():
            Gtk.main_iteration_do(False)
        gdk_win = gtk_win.get_window()
        if gdk_win is None:
            return
        w, h = gtk_win.get_size()
        pb = Gdk.pixbuf_get_from_window(gdk_win, 0, 0, w, h)
        if pb is not None:
            pb.savev(out_path, "png", [], [])
    except Exception:
        pass


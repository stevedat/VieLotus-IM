def get_live_ibus_env():
    env = dict(os.environ)
    bus_dir = os.path.join(os.path.expanduser("~/.config"), "ibus", "bus")
    if os.path.isdir(bus_dir):
        try:
            files = sorted(
                (os.path.join(bus_dir, fn) for fn in os.listdir(bus_dir)),
                key=lambda p: os.path.getmtime(p),
                reverse=True,
            )
            for bf in files:
                if not os.path.isfile(bf):
                    continue
                pid_s, addr_s = "", ""
                with open(bf, "r", encoding="utf-8", errors="ignore") as f:
                    for ln in f:
                        if ln.startswith("IBUS_DAEMON_PID="):
                            pid_s = ln.split("=", 1)[1].strip().strip('"').strip("'")
                        elif ln.startswith("IBUS_ADDRESS="):
                            addr_s = ln.split("=", 1)[1].strip().strip('"').strip("'")
                if pid_s.isdigit() and addr_s:
                    try:
                        os.kill(int(pid_s), 0)
                        env["IBUS_ADDRESS"] = addr_s
                        break
                    except OSError:
                        pass
        except Exception:
            pass
    return env

def detect_linux_ime_status():
    def proc_up(name):
        try:
            return subprocess.call(["pgrep", "-x", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0
        except Exception:
            return False
    fcitx_up = proc_up("fcitx5")
    ibus_up = proc_up("ibus-daemon")
    gtk_im = os.environ.get("GTK_IM_MODULE", "")
    qt_im = os.environ.get("QT_IM_MODULE", "")
    xmod = os.environ.get("XMODIFIERS", "")
    im_vars = (gtk_im + " " + qt_im + " " + xmod).lower()
    if fcitx_up and not ibus_up and "ibus" in im_vars:
        return ("warn", "Lệch biến môi trường (Fcitx5 ↔ IBus)", "Bấm Riêng Linux để tự động đồng bộ")
    if ibus_up and not fcitx_up and "fcitx" in im_vars:
        return ("warn", "Lệch biến môi trường (IBus ↔ Fcitx5)", "Bấm Riêng Linux để tự động đồng bộ")
    if fcitx_up:
        return ("ok", "Sen Việt đang bật (Fcitx5)", "Super+Space hoặc Ctrl+Space chuyển gõ")
    if ibus_up:
        ibus_cli = shutil.which("ibus")
        if ibus_cli:
            try:
                eng_out = subprocess.check_output(
                    [ibus_cli, "list-engine"],
                    env=get_live_ibus_env(),
                    stderr=subprocess.DEVNULL,
                    timeout=0.7,
                ).decode("utf-8", errors="replace")
                if "vielotus" not in eng_out:
                    return (
                        "warn",
                        "Mới cài đặt: Cần Đăng xuất (Log Out) 1 lần",
                        "Bấm Riêng Linux → Tự sửa, hoặc Log Out & Log In để hiện đủ Sen Việt",
                    )
            except Exception:
                pass
        desk_env = (os.environ.get("XDG_CURRENT_DESKTOP", "") + " " + os.environ.get("DESKTOP_SESSION", "")).lower()
        gset_cli = shutil.which("gsettings")
        if gset_cli and ("gnome" in desk_env or "ubuntu" in desk_env):
            try:
                mru_raw = subprocess.check_output(
                    [gset_cli, "get", "org.gnome.desktop.input-sources", "mru-sources"],
                    stderr=subprocess.DEVNULL,
                    timeout=0.5,
                ).decode("utf-8", errors="replace").strip()
                if mru_raw.startswith("@a(ss) "):
                    mru_raw = mru_raw[len("@a(ss) "):]
                mru_list = list(ast.literal_eval(mru_raw)) if mru_raw else []
                if mru_list and mru_list[0] == ("xkb", "vn"):
                    return (
                        "warn",
                        "Đang chọn bàn phím tĩnh 'Vietnamese (vi)'",
                        "Hãy chọn '🇻🇳 tex' trên thanh trên cùng để gõ dấu (không chọn 'vi')",
                    )
            except Exception:
                pass
        im_badge = "vni" if cfg["INPUT_METHOD"] == "vni" else "tex"
        return ("ok", f"Sen Việt đang bật (IBus • {im_badge})", "Super+Space chuyển gõ • Mới cài thiếu tên hãy Log Out 1 lần")
    return ("warn", "Chưa phát hiện daemon bộ gõ", "Bấm Riêng Linux → Tự sửa & Kích hoạt")


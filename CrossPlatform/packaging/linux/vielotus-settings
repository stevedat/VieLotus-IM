        show_banner("Đã mở GitHub Issues (điền sẵn thông số) và sao chép dự phòng vào Clipboard!")

    ftr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    ftr.get_style_context().add_class("bento-footer")
    b_cp = Gtk.Button(label="Sao chép")

qt_var = tk.BooleanVar(value=cfg.get("QUICK_TELEX", "false") == "true")
rc_var = tk.BooleanVar(value=cfg.get("RELAXED_CODA", "false") == "true")
mc_var = tk.BooleanVar(value=cfg.get("MACRO_ENABLED", "true") == "true")
dv_var = tk.BooleanVar(value=cfg.get("DEVELOPER_MODE", "false") == "true")

def apply_changes(*_):
    cfg["INPUT_METHOD"] = im_var.get()
    cfg["QUICK_TELEX"] = "true" if qt_var.get() else "false"
    cfg["RELAXED_CODA"] = "true" if rc_var.get() else "false"
    cfg["MACRO_ENABLED"] = "true" if mc_var.get() else "false"
    cfg["DEVELOPER_MODE"] = "true" if dv_var.get() else "false"
    os.makedirs(os.path.dirname(config_path), exist_ok=True)
    with open(config_path, "w", encoding="utf-8") as f:
        for k, v in cfg.items():
            f.write(f'{k}="{v}"\n')
    im_flag = "--vni" if cfg["INPUT_METHOD"] == "vni" else "--telex"
    subprocess.Popen(["/usr/bin/vielotus-settings", im_flag], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

frm = ttk.Frame(root, padding=16)

def atomic_write_text(path, content):
    parent = os.path.dirname(os.path.abspath(path))
    os.makedirs(parent, mode=0o700, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(prefix=".vielotus.", dir=parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as tf:
            tf.write(content)
            tf.flush()
            os.fsync(tf.fileno())
        os.replace(tmp_path, path)
    except Exception:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise

def atomic_merge_config_env(path, values):
    seen = set()
    out_lines = []
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for raw_line in f:
                stripped = raw_line.lstrip()
                if not stripped or stripped.startswith("#") or "=" not in raw_line:
                    out_lines.append(raw_line if raw_line.endswith("\n") else raw_line + "\n")
                    continue
                k_part, _ = raw_line.split("=", 1)
                k = k_part.strip()
                if k in CANONICAL_KEYS:
                    if k not in seen:
                        out_lines.append(f'{k}="{values[k]}"\n')
                        seen.add(k)
                else:
                    out_lines.append(raw_line if raw_line.endswith("\n") else raw_line + "\n")
    for k in CANONICAL_KEYS:
        if k not in seen:
            out_lines.append(f'{k}="{values[k]}"\n')
    atomic_write_text(path, "".join(out_lines))


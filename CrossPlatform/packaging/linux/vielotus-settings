def build_hero_card(glyph, title, code_pill, desc, active, is_toggle=False):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
    top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    badge_fg = "#ffffff" if active else P["fg_secondary"]
    badge_cls = "bento-icon-accent" if active else "bento-icon-muted"
    top_row.pack_start(make_icon_badge(glyph, badge_fg, badge_cls), False, False, 0)

    l1 = Gtk.Label()
    l1.set_markup(f"<span size='9600' weight='bold' foreground='{P['fg_primary']}'>{title}</span>")
    l1.set_xalign(0)
    top_row.pack_start(l1, True, True, 0)

    if is_toggle:
        pill_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        pill_box.get_style_context().add_class("bento-ver-pill" if active else "bento-status-off")
        pill_box.set_valign(Gtk.Align.CENTER)
        p_lbl = Gtk.Label()
        p_col = P["accent"] if active else P["fg_secondary"]
        p_lbl.set_markup(f"<span size='7500' weight='bold' foreground='{p_col}'>{'BẬT' if active else 'TẮT'}</span>")
        pill_box.pack_start(p_lbl, False, False, 0)
        top_row.pack_end(pill_box, False, False, 0)
    else:
        chk = Gtk.Label()
        chk_mark = "●" if active else "○"
        chk_col = P["accent"] if active else P["fg_secondary"]
        chk.set_markup(f"<span size='10000' weight='bold' foreground='{chk_col}'>{chk_mark}</span>")
        top_row.pack_end(chk, False, False, 0)

    bot_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    code_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
    code_box.get_style_context().add_class("bento-code-accent" if active else "bento-code-muted")
    code_lbl = Gtk.Label()
    code_col = P["accent"] if active else P["fg_secondary"]
    code_lbl.set_markup(f"<tt><span size='7800' weight='bold' foreground='{code_col}'>{code_pill}</span></tt>")
    code_box.pack_start(code_lbl, False, False, 0)

    l2 = Gtk.Label()
    l2.set_markup(f"<span size='8300' foreground='{P['fg_secondary']}'>{desc}</span>")
    l2.set_xalign(0)
    bot_row.pack_start(code_box, False, False, 0)
    bot_row.pack_start(l2, True, True, 0)

    box.pack_start(top_row, False, False, 0)
    box.pack_start(bot_row, False, False, 0)
    return box

def refresh_hero_cards():
    is_vni = cfg["INPUT_METHOD"] == "vni"
    is_flex = cfg["GRAMMAR_PROFILE"] != "classic"
    for btn, active, glyph, title, pill, desc, is_tog in (
        (btn_telex, not is_vni, "TX", "Telex Tự Do", "s f r x j w", "vieetj → việt", False),
        (btn_vni, is_vni, "19", "VNI (Số 1–9)", "1–5 • 6–9", "viet65 → việt", False),
        (btn_flex, is_flex, "✦", "Dấu trước âm", "rrung → rủng", "Đang bật" if is_flex else "Đang tắt", True),
    ):
        ctx = btn.get_style_context()
        ctx.remove_class("bento-card")
        ctx.remove_class("bento-card-active")
        ctx.add_class("bento-card-active" if active else "bento-card")
        child = btn.get_child()
        if child is not None:
            btn.remove(child)
        btn.add(build_hero_card(glyph, title, pill, desc, active, is_tog))
        btn.show_all()


    def build_ime_diag_block():
        _sk, st_t, st_s = detect_linux_ime_status()
        lines = [
            f"- **Kiểu gõ (Input Method):** `{im_title}` (`{cfg['GRAMMAR_PROFILE']}`)",
            f"- **Song ngữ thông minh (Smart Bilingual):** `{'Bật' if cfg['SMART_BILINGUAL'] == 'true' else 'Tắt'}`",
            f"- **Chính tả chuẩn mới (oà, uý):** `{'Bật' if cfg['MODERN_ORTHOGRAPHY'] == 'true' else 'Tắt'}`",
            f"- **Bảng gõ tắt (Macros):** `{'Bật' if cfg['MACRO_ENABLED'] == 'true' else 'Tắt'}` (`{len(macros_data)}` cụm từ)",
            f"- **Chế độ Code (Developer Mode):** `{'Bật' if cfg['DEVELOPER_MODE'] == 'true' else 'Tắt'}`",
            f"- **Tốc gõ phụ âm (QuickTelex / RelaxedCoda):** `{cfg['QUICK_TELEX']} / {cfg['RELAXED_CODA']}`",
            f"- **Hiện gạch chân Preedit:** `{'Bật' if cfg['PREEDIT_UNDERLINE'] == 'true' else 'Tắt'}`",
            f"- **Trạng thái Daemon Linux:** `{st_t} — {st_s}`",
            f"- **Quy tắc Ứng dụng (typing-modes.yml):** `{len(app_rules)} quy tắc cá nhân`",
        ]
        return "\n".join(lines)

    def compile_report_and_title():
        _kid, _kbtn, k_prefix, k_title = get_kind_meta()
        t_keys = e_typed.get_text().strip() if fb_state["kind"] in ("word_bug", "app_compat") else ""
        t_act = e_actual.get_text().strip() if fb_state["kind"] in ("word_bug", "app_compat") else ""
        t_exp = e_expect.get_text().strip() if fb_state["kind"] in ("word_bug", "app_compat") else ""
        t_top = e_topic.get_text().strip()
        t_eml = e_email.get_text().strip()
        s_it, e_it = desc_buf.get_bounds()
        t_msg = desc_buf.get_text(s_it, e_it, False).strip()

        if t_keys:
            hdr_topic = f"Gõ `{t_keys}` ra `{t_act or '?'}` (mong muốn `{t_exp or '?'}`)"
            issue_sum = f'Gõ "{t_keys}" ra "{t_act or "?"}" (mong muốn "{t_exp or "?"}")'
        elif t_top:
            hdr_topic = t_top
            issue_sum = t_top
        elif t_msg:
            first_ln = t_msg.splitlines()[0][:64]
            hdr_topic = k_title
            issue_sum = first_ln
        else:
            hdr_topic = k_title
            issue_sum = k_title

        issue_title = f"{k_prefix} {issue_sum} (Linux v2.0.2)"
        lines = [f"### {k_prefix} {hdr_topic}", ""]
        if t_keys or t_act or t_exp:
            lines.append(f"- **Chuỗi phím đã gõ (Typed Keys):** `{t_keys or '—'}`")
            lines.append(f"- **Sen Việt hiện ra (Actual Output):** `{t_act or '—'}`")
            lines.append(f"- **Kết quả mong muốn (Expected Output):** `{t_exp or '—'}`")
        if t_top:
            lines.append(f"- **Ứng dụng / Chủ đề (App / Topic):** `{t_top}`")
        if t_eml:
            lines.append(f"- **Email liên hệ (Contact):** `{t_eml}`")
        if t_msg:
            lines.extend(["", "**Mô tả chi tiết / Description:**", t_msg, ""])
        if cb_diag.get_active():
            lines.extend([
                f"- **Phiên bản & Hệ điều hành (System):** `{sys_badge_str}`",
                "",
                "<details>",
                "<summary><strong>Thông số Cấu hình &amp; Chẩn đoán Bộ gõ (Linux IME Diagnostics)</strong></summary>",
                "",
                build_ime_diag_block(),
                "",
                "</details>",
            ])
        return "\n".join(lines), issue_title

    def refresh_diag_preview(*_):
        if fb_state["preview_open"]:
            rep_md, _ = compile_report_and_title()
            prev_buf.set_text(rep_md)

    def toggle_diag_preview(*_):
        fb_state["preview_open"] = not fb_state["preview_open"]

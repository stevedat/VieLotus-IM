import os, subprocess, sys, tempfile
import tkinter as tk
from tkinter import ttk

config_path = sys.argv[1]
CANONICAL_KEYS = (
    "INPUT_METHOD",
    "GRAMMAR_PROFILE",
    "SMART_BILINGUAL",
    "MODERN_ORTHOGRAPHY",
    "QUICK_TELEX",
    "RELAXED_CODA",
    "MACRO_ENABLED",
    "DEVELOPER_MODE",
    "PREEDIT_UNDERLINE",
)
cfg = {
    "INPUT_METHOD": "telex",
    "GRAMMAR_PROFILE": "classic",
    "SMART_BILINGUAL": "true",
    "MODERN_ORTHOGRAPHY": "true",
    "QUICK_TELEX": "false",
    "RELAXED_CODA": "false",
    "MACRO_ENABLED": "false",
    "DEVELOPER_MODE": "false",
    "PREEDIT_UNDERLINE": "false",
}
if os.path.exists(config_path):
    with open(config_path, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.strip().split("=", 1)
                cfg[k.strip()] = v.strip().strip('"').strip("'")

root = tk.Tk()
root.title("Sen Việt (VieLotusIM v2.0.2) — Cài đặt")
root.geometry("460x320")
root.resizable(False, False)

im_var = tk.StringVar(value="vni" if cfg.get("INPUT_METHOD", "").lower() == "vni" else "telex")
qt_var = tk.BooleanVar(value=cfg.get("QUICK_TELEX", "false").lower() == "true")
rc_var = tk.BooleanVar(value=cfg.get("RELAXED_CODA", "false").lower() == "true")
mc_var = tk.BooleanVar(value=cfg.get("MACRO_ENABLED", "false").lower() == "true")
dv_var = tk.BooleanVar(value=cfg.get("DEVELOPER_MODE", "false").lower() == "true")

def apply_changes(*_):
    cfg["INPUT_METHOD"] = im_var.get()
    cfg["QUICK_TELEX"] = "true" if qt_var.get() else "false"
    cfg["RELAXED_CODA"] = "true" if rc_var.get() else "false"
    cfg["MACRO_ENABLED"] = "true" if mc_var.get() else "false"
    cfg["DEVELOPER_MODE"] = "true" if dv_var.get() else "false"
    parent = os.path.dirname(os.path.abspath(config_path))
    os.makedirs(parent, mode=0o700, exist_ok=True)
    seen = set()
    lines = []
    if os.path.exists(config_path):
        with open(config_path, "r", encoding="utf-8", errors="replace") as rf:
            for raw_line in rf:
                st = raw_line.lstrip()
                if not st or st.startswith("#") or "=" not in raw_line:
                    lines.append(raw_line if raw_line.endswith("\n") else raw_line + "\n")
                    continue
                kp, _ = raw_line.split("=", 1)
                k = kp.strip()
                if k in CANONICAL_KEYS:
                    if k not in seen:
                        lines.append(f'{k}="{cfg[k]}"\n')
                        seen.add(k)
                else:
                    lines.append(raw_line if raw_line.endswith("\n") else raw_line + "\n")
    for k in CANONICAL_KEYS:
        if k not in seen:
            lines.append(f'{k}="{cfg[k]}"\n')
    fd, tmp_p = tempfile.mkstemp(prefix=".config.env.", dir=parent)
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as tf:
        tf.writelines(lines)
    os.replace(tmp_p, config_path)
    settings_bin = "/usr/bin/vielotus-settings"
    if not os.path.exists(settings_bin):
        settings_bin = os.path.abspath(sys.argv[0])
    im_flag = "--vni" if cfg["INPUT_METHOD"] == "vni" else "--telex"
    subprocess.Popen([settings_bin, im_flag], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


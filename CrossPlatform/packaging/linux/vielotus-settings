    def persist_m():
        payload = json.dumps(dict(sorted(macros_data.items())), ensure_ascii=False, indent=2) + "\n"
        atomic_write_text(macros_path, payload)
        reload_m_store()
        notify_running_engines()

    def on_sel(sel):
        model, it = sel.get_selected()
        if it is not None:
            e_key.set_text(model[it][0])
            e_val.set_text(model[it][1])
    tree.get_selection().connect("changed", on_sel)
    e_search.connect("changed", lambda *_: reload_m_store())

    def on_save(*_):
        k = e_key.get_text().strip().lower()
        v = e_val.get_text().strip()
        if not k or not v or " " in k:
            return
        macros_data[k] = v
        e_key.set_text("")
        e_val.set_text("")
        persist_m()

    def on_del(*_):
        model, it = tree.get_selection().get_selected()
        k = model[it][0] if it is not None else e_key.get_text().strip().lower()
        if k in macros_data:
            del macros_data[k]
            e_key.set_text("")
            e_val.set_text("")
            persist_m()

    def on_reset(*_):
        macros_data.clear()
        macros_data.update(FACTORY_DEFAULT_MACROS)
        try:
            if os.path.exists(macros_path):
                os.unlink(macros_path)
        except OSError:
            pass
        reload_m_store()
        notify_running_engines()

    def on_open_json(*_):
        if not os.path.exists(macros_path):
            persist_m()
        try:
            subprocess.Popen(["xdg-open", macros_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    b_save.connect("clicked", on_save)
    e_val.connect("activate", on_save)
    b_del.connect("clicked", on_del)


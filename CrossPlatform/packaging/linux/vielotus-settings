def save_current_config(*_):
    os.makedirs(os.path.dirname(config_path), exist_ok=True)
    with open(config_path, "w", encoding="utf-8") as f:
        for key in (
            "INPUT_METHOD",
            "GRAMMAR_PROFILE",
            "SMART_BILINGUAL",
            "MODERN_ORTHOGRAPHY",
            "QUICK_TELEX",
            "RELAXED_CODA",
            "MACRO_ENABLED",
            "DEVELOPER_MODE",
            "PREEDIT_UNDERLINE",
        ):
            f.write(f'{key}="{cfg[key]}"\n')
    settings_bin = "/usr/bin/vielotus-settings"
    if not os.path.exists(settings_bin):
        settings_bin = os.path.abspath(sys.argv[0])
    im_flag = "--vni" if cfg["INPUT_METHOD"] == "vni" else "--telex"
    if smoke_mode:
        subprocess.call([settings_bin, im_flag])
    else:
        subprocess.Popen(
            [settings_bin, im_flag],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


    ftr.pack_end(b_cls, False, False, 0)
    vbox.pack_end(ftr, False, False, 0)

    reload_m_store()
    dlg.show_all()
    if auto_close:
        while Gtk.events_pending():
            Gtk.main_iteration_do(False)
        dlg.destroy()
    return dlg


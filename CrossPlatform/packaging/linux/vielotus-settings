    b_zl.connect("clicked", on_fb_zalo)
    b_em = Gtk.Button(label="✉ Gửi Email")
    b_em.get_style_context().add_class("bento-btn")
    b_em.connect("clicked", on_fb_email)
    b_gh = Gtk.Button(label="➤ Gửi lên GitHub Issues")
    b_gh.get_style_context().add_class("bento-btn-indigo-rect")
    b_gh.connect("clicked", on_fb_github)

    ftr.pack_start(b_cp, False, False, 0)
    ftr.pack_start(b_zl, False, False, 0)
    ftr.pack_start(b_em, False, False, 0)
    ftr.pack_end(b_gh, False, False, 0)
    vbox.pack_end(ftr, False, False, 0)

    dlg.show_all()
    select_fb_kind("word_bug")
    if auto_close:
        while Gtk.events_pending():
            Gtk.main_iteration_do(False)
        dlg.destroy()
    return dlg


        f"<span size='small' foreground='{P['fg_secondary']}'>{desc}</span>"
    )
    l2.set_xalign(0)
    box.pack_start(top_row, False, False, 0)
    box.pack_start(l2, False, False, 0)
    return box

def refresh_hero_cards():
    is_vni = cfg["INPUT_METHOD"] == "vni"
    for btn, active, title, pill, desc in (
        (btn_telex, not is_vni, "Telex Tự Do", "s f r x j w", "vieetj → việt"),
        (btn_vni, is_vni, "VNI (Số 1–9)", "1–5 • 6–9", "viet65 → việt"),
    ):
        ctx = btn.get_style_context()
        ctx.remove_class("bento-card")
        ctx.remove_class("bento-card-active")
        ctx.add_class("bento-card-active" if active else "bento-card")
        child = btn.get_child()
        if child is not None:
            btn.remove(child)
        btn.add(build_hero_card_content(title, pill, desc, active))
        btn.show_all()

def on_select_im(mode):
    if cfg["INPUT_METHOD"] != mode:
        cfg["INPUT_METHOD"] = mode
        refresh_hero_cards()
        save_current_config()


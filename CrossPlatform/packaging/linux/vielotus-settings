        webbrowser.open(f"mailto:{SUPPORT_EMAIL}?{q}")
        show_banner("Đã mở trình gửi Email (điền sẵn nội dung) và sao chép dự phòng vào Clipboard!")

    def on_fb_github(*_):
        rep_md, iss_title = copy_report()

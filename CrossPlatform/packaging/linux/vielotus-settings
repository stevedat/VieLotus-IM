#!/bin/sh
# ==============================================================================
# Sen Việt (VieLotusIM) — Linux Desktop Settings & Auto-Activation Utility
# Supports both Fcitx5 (fcitx5-configtool) and IBus (GNOME Input Sources)
# ==============================================================================

export LD_LIBRARY_PATH="/usr/lib:/usr/lib/vielotus:${LD_LIBRARY_PATH:-}"
UID_CUR="$(id -u 2>/dev/null || echo 1000)"
CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_DIR="${CONFIG_ROOT}/vielotus"
mkdir -p "${CONFIG_DIR}" 2>/dev/null || true
if [ ! -w "${CONFIG_DIR}" ]; then
    CONFIG_DIR="/tmp/vielotus-cfg-${UID_CUR}"
    mkdir -p "${CONFIG_DIR}" 2>/dev/null || true
fi
CONFIG_FILE="${CONFIG_DIR}/config.env"
LOG_FILE="${CONFIG_DIR}/settings.log"

INPUT_METHOD="telex"
GRAMMAR_PROFILE="sen_flex"
SMART_BILINGUAL="true"
MODERN_ORTHOGRAPHY="true"
QUICK_TELEX="false"
RELAXED_CODA="false"
MACRO_ENABLED="true"
DEVELOPER_MODE="false"
PREEDIT_UNDERLINE="false"

load_config() {
    if [ ! -f "${CONFIG_FILE}" ]; then
        return 0
    fi
    while IFS='=' read -r raw_key raw_val || [ -n "${raw_key}" ]; do
        key=$(printf '%s' "${raw_key}" | tr -d '[:space:]')
        case "${key}" in
            ''|\#*) continue ;;
        esac
        val=$(printf '%s' "${raw_val}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
        case "${key}" in
            INPUT_METHOD)
                case "${val}" in
                    vni|VNI) INPUT_METHOD="vni" ;;
                    *) INPUT_METHOD="telex" ;;
                esac
                ;;
            GRAMMAR_PROFILE)
                case "${val}" in
                    classic|Classic|CLASSIC) GRAMMAR_PROFILE="classic" ;;
                    *) GRAMMAR_PROFILE="sen_flex" ;;
                esac
                ;;
            SMART_BILINGUAL)
                case "${val}" in
                    false|False|FALSE|0) SMART_BILINGUAL="false" ;;
                    *) SMART_BILINGUAL="true" ;;
                esac
                ;;
            MODERN_ORTHOGRAPHY)
                case "${val}" in
                    false|False|FALSE|0) MODERN_ORTHOGRAPHY="false" ;;
                    *) MODERN_ORTHOGRAPHY="true" ;;
                esac
                ;;
            QUICK_TELEX)
                case "${val}" in
                    true|True|TRUE|1) QUICK_TELEX="true" ;;
                    *) QUICK_TELEX="false" ;;
                esac
                ;;
            RELAXED_CODA)
                case "${val}" in
                    true|True|TRUE|1) RELAXED_CODA="true" ;;
                    *) RELAXED_CODA="false" ;;
                esac
                ;;
            MACRO_ENABLED)
                case "${val}" in
                    false|False|FALSE|0) MACRO_ENABLED="false" ;;
                    *) MACRO_ENABLED="true" ;;
                esac
                ;;
            DEVELOPER_MODE)
                case "${val}" in
                    true|True|TRUE|1) DEVELOPER_MODE="true" ;;
                    *) DEVELOPER_MODE="false" ;;
                esac
                ;;
            PREEDIT_UNDERLINE)
                case "${val}" in
                    true|True|TRUE|1) PREEDIT_UNDERLINE="true" ;;
                    *) PREEDIT_UNDERLINE="false" ;;
                esac
                ;;
        esac
    done < "${CONFIG_FILE}"
}

load_config

sync_fcitx5_metadata() {
    USER_FCITX_DIR="${DATA_ROOT}/fcitx5"
    # If system-wide Fcitx5 metadata is installed via .deb, remove any redundant user copies
    if [ -f /usr/share/fcitx5/addon/vielotus.conf ] && [ -f /usr/share/fcitx5/inputmethod/vielotus-telex.conf ]; then
        rm -f "${USER_FCITX_DIR}/addon/vielotus.conf" \
              "${USER_FCITX_DIR}/inputmethod/vielotus-telex.conf" \
              "${USER_FCITX_DIR}/inputmethod/vielotus-vni.conf" 2>/dev/null || true
        return 0
    fi

    mkdir -p "${USER_FCITX_DIR}/addon" "${USER_FCITX_DIR}/inputmethod"
    cat <<'ADDON_EOF' > "${USER_FCITX_DIR}/addon/vielotus.conf"
[Addon]
Name[vi]=Bộ gõ tiếng Việt Sen Việt (VieLotus)
Name=Sen Việt (VieLotus)
Comment=Next-Gen Pure Vietnamese Input Engine for Fcitx5
Category=InputMethod
Version=2.0.0
Enabled=True
Library=vielotus
Type=SharedLibrary
OnDemand=True
Configurable=True

[Dependencies]
0=core:5.0.0
ADDON_EOF

    cat <<'TELEX_EOF' > "${USER_FCITX_DIR}/inputmethod/vielotus-telex.conf"
[InputMethod]
Name=Sen Việt (Telex)
Icon=vielotus
Label=VN
LangCode=vi
Addon=vielotus
Configurable=True
TELEX_EOF

    cat <<'VNI_EOF' > "${USER_FCITX_DIR}/inputmethod/vielotus-vni.conf"
[InputMethod]
Name=Sen Việt (VNI)
Icon=vielotus
Label=VNI
LangCode=vi
Addon=vielotus
Configurable=True
VNI_EOF
}

configure_fcitx5_profile() {
    FCITX_IM="$1"
    FCITX_PROFILE_DIR="${CONFIG_ROOT}/fcitx5"
    FCITX_PROFILE="${FCITX_PROFILE_DIR}/profile"
    mkdir -p "${FCITX_PROFILE_DIR}/conf"

    FCITX_GRAMMAR="SenFlex"
    if [ "${GRAMMAR_PROFILE}" = "classic" ]; then
        FCITX_GRAMMAR="Classic"
    fi
    FCITX_SB="True"
    [ "${SMART_BILINGUAL}" = "false" ] && FCITX_SB="False"
    FCITX_MOD="True"
    [ "${MODERN_ORTHOGRAPHY}" = "false" ] && FCITX_MOD="False"
    FCITX_QT="False"
    [ "${QUICK_TELEX}" = "true" ] && FCITX_QT="True"

    cat <<FCITX_CONF_EOF > "${FCITX_PROFILE_DIR}/conf/vielotus.conf"
# Chế độ đặt dấu (Grammar Profile)
GrammarProfile=${FCITX_GRAMMAR}
# Song ngữ thông minh Anh-Việt (Smart Bilingual)
SmartBilingual=${FCITX_SB}
# Chính tả hiện đại: oà, uý (thay vì òa, úy)
ModernOrthography=${FCITX_MOD}
# Gõ tắt phụ âm (Quick Telex: cc=ch, gg=gi, kk=kh...)
QuickTelex=${FCITX_QT}
FCITX_CONF_EOF

    if [ ! -f "${FCITX_PROFILE}" ]; then
        cat <<PROFILE_EOF > "${FCITX_PROFILE}"
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=${FCITX_IM}

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=${FCITX_IM}
Layout=

[GroupOrder]
0=Default
PROFILE_EOF
    elif command -v python3 >/dev/null 2>&1; then
        python3 - "${FCITX_PROFILE}" "${FCITX_IM}" <<'PYEOF' 2>/dev/null || true
import re, sys

profile_path, im_name = sys.argv[1], sys.argv[2]
with open(profile_path, "r", encoding="utf-8", errors="ignore") as f:
    text = f.read()

if "DefaultIM=" in text:
    text = re.sub(r"^DefaultIM=.*$", f"DefaultIM={im_name}", text, count=1, flags=re.M)

if re.search(r"^Name=vielotus-(telex|vni)$", text, flags=re.M):
    text = re.sub(r"^Name=vielotus-(telex|vni)$", f"Name={im_name}", text, count=1, flags=re.M)
elif f"Name={im_name}" not in text:
    indices = [int(m) for m in re.findall(r"^\[Groups/0/Items/(\d+)\]", text, flags=re.M)]
    next_idx = (max(indices) + 1) if indices else 1
    new_item = f"\n[Groups/0/Items/{next_idx}]\nName={im_name}\nLayout=\n"
    if "[GroupOrder]" in text:
        text = text.replace("[GroupOrder]", new_item.lstrip("\n") + "\n[GroupOrder]", 1)
    else:
        text = text.rstrip() + "\n" + new_item

with open(profile_path, "w", encoding="utf-8") as f:
    f.write(text)
PYEOF
    fi
}

save_and_apply() {
    MODE="${1:-$INPUT_METHOD}"
    case "${MODE}" in
        vni|VNI) INPUT_METHOD="vni" ;;
        *) INPUT_METHOD="telex" ;;
    esac

    cat <<ENV_EOF > "${CONFIG_FILE}"
INPUT_METHOD="${INPUT_METHOD}"
GRAMMAR_PROFILE="${GRAMMAR_PROFILE}"
SMART_BILINGUAL="${SMART_BILINGUAL}"
MODERN_ORTHOGRAPHY="${MODERN_ORTHOGRAPHY}"
QUICK_TELEX="${QUICK_TELEX}"
RELAXED_CODA="${RELAXED_CODA}"
MACRO_ENABLED="${MACRO_ENABLED}"
DEVELOPER_MODE="${DEVELOPER_MODE}"
PREEDIT_UNDERLINE="${PREEDIT_UNDERLINE}"
ENV_EOF

    ENGINE_ID="vielotus"
    FCITX_IM_ID="vielotus-telex"
    if [ "${INPUT_METHOD}" = "vni" ]; then
        ENGINE_ID="vielotus-vni"
        FCITX_IM_ID="vielotus-vni"
    fi

    # 1. Sync Fcitx5 metadata & update Fcitx5 profile
    sync_fcitx5_metadata || true
    configure_fcitx5_profile "${FCITX_IM_ID}" || true

    # Reload/switch Fcitx5 if running
    if command -v fcitx5 >/dev/null 2>&1; then
        if pgrep -x fcitx5 >/dev/null 2>&1 || [ "${XMODIFIERS:-}" = "@im=fcitx" ] || [ "${GTK_IM_MODULE:-}" = "fcitx" ]; then
            if command -v fcitx5-remote >/dev/null 2>&1; then
                fcitx5-remote -r >/dev/null 2>&1 || fcitx5 -r -d >/dev/null 2>&1 || true
                fcitx5-remote -s "${FCITX_IM_ID}" >/dev/null 2>&1 || true
            else
                fcitx5 -r -d >/dev/null 2>&1 || true
            fi
        fi
    fi

    # 2. Refresh IBus cache & switch active engine non-blockingly if IBus daemon is reachable
    if command -v ibus >/dev/null 2>&1; then
        (ibus write-cache >/dev/null 2>&1 || true) &
        if pgrep -x ibus-daemon >/dev/null 2>&1; then
            (ibus engine "${ENGINE_ID}" >/dev/null 2>&1 || true) &
        fi
    fi

    # Refresh user & Snap Store fontconfig + local font links so Vietnamese glyphs (U+1EA0..U+1EF9: ệ, ộ, ậ, ử...) render cleanly everywhere
    FONTCONF_DIR="${CONFIG_ROOT}/fontconfig/conf.d"
    FONTCONF_FILE="${FONTCONF_DIR}/99-vielotus-vietnamese.conf"
    mkdir -p "${FONTCONF_DIR}" 2>/dev/null || true
    cat <<'FC_EOF' > "${FONTCONF_FILE}" 2>/dev/null || true
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <selectfont>
    <rejectfont>
      <glob>/usr/share/fonts/truetype/ubuntu/*</glob>
      <glob>/var/lib/snapd/hostfs/usr/share/fonts/truetype/ubuntu/*</glob>
      <glob>/snap/*/usr/share/fonts/truetype/ubuntu/*</glob>
    </rejectfont>
  </selectfont>
  <match target="pattern">
    <test qual="any" name="family">
      <string>Ubuntu</string>
    </test>
    <edit name="family" mode="assign" binding="same">
      <string>DejaVu Sans</string>
    </edit>
  </match>
  <match target="pattern">
    <test qual="any" name="family">
      <string>Ubuntu Sans</string>
    </test>
    <edit name="family" mode="assign" binding="same">
      <string>DejaVu Sans</string>
    </edit>
  </match>
  <match target="pattern">
    <test qual="any" name="family">
      <string>Ubuntu Mono</string>
    </test>
    <edit name="family" mode="assign" binding="same">
      <string>DejaVu Sans Mono</string>
    </edit>
  </match>
  <match target="pattern">
    <test qual="any" name="family">
      <string>Ubuntu Sans Mono</string>
    </test>
    <edit name="family" mode="assign" binding="same">
      <string>DejaVu Sans Mono</string>
    </edit>
  </match>
  <alias>
    <family>sans-serif</family>
    <prefer>
      <family>DejaVu Sans</family>
      <family>Noto Sans</family>
    </prefer>
  </alias>
  <alias>
    <family>system-ui</family>
    <prefer>
      <family>DejaVu Sans</family>
      <family>Noto Sans</family>
    </prefer>
  </alias>
</fontconfig>
FC_EOF
    cp -f "${FONTCONF_FILE}" "${CONFIG_ROOT}/fontconfig/fonts.conf" 2>/dev/null || true
    USER_FONTS_DIR="${DATA_ROOT}/fonts/vielotus"
    mkdir -p "${USER_FONTS_DIR}" 2>/dev/null || true
    for sys_font in \
        /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \
        /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf \
        /usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf \
        /usr/share/fonts/truetype/noto/NotoSans-Regular.ttf \
        /usr/share/fonts/truetype/noto/NotoSans-Bold.ttf; do
        if [ -f "${sys_font}" ]; then
            cp -f "${sys_font}" "${USER_FONTS_DIR}/" 2>/dev/null || true
        fi
    done
    # Switch GNOME interface font away from buggy Ubuntu Sans variable font if needed
    if command -v gsettings >/dev/null 2>&1; then
        CUR_FONT=$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null || true)
        case "${CUR_FONT}" in
            *Ubuntu*)
                if [ -f /usr/share/fonts/truetype/noto/NotoSans-Regular.ttf ]; then
                    gsettings set org.gnome.desktop.interface font-name 'Noto Sans 11' 2>/dev/null || true
                elif [ -f /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf ]; then
                    gsettings set org.gnome.desktop.interface font-name 'DejaVu Sans 11' 2>/dev/null || true
                fi
                ;;
        esac
    fi
    # Propagate fontconfig & fallback fonts into Snap sandboxes (especially snap-store / App Center)
    mkdir -p "${HOME}/snap/snap-store/current" "${HOME}/snap/snap-store/common" 2>/dev/null || true
    for snap_app_dir in "${HOME}"/snap/*; do
        [ -d "${snap_app_dir}" ] || continue
        for sub in current common; do
            if [ -d "${snap_app_dir}/${sub}" ]; then
                mkdir -p "${snap_app_dir}/${sub}/.config/fontconfig/conf.d" 2>/dev/null || true
                cp -f "${FONTCONF_FILE}" "${snap_app_dir}/${sub}/.config/fontconfig/conf.d/99-vielotus-vietnamese.conf" 2>/dev/null || true
                cp -f "${FONTCONF_FILE}" "${snap_app_dir}/${sub}/.config/fontconfig/fonts.conf" 2>/dev/null || true
                cp -f "${FONTCONF_FILE}" "${snap_app_dir}/${sub}/.fonts.conf" 2>/dev/null || true
            fi
        done
        if [ -d "${snap_app_dir}/current" ]; then
            mkdir -p "${snap_app_dir}/current/.local/share/fonts" 2>/dev/null || true
            cp -f "${USER_FONTS_DIR}/"*.ttf "${snap_app_dir}/current/.local/share/fonts/" 2>/dev/null || true
        fi
    done
    rm -rf "${HOME}/.cache/fontconfig" \
           "${HOME}"/snap/*/common/.cache/fontconfig \
           "${HOME}"/snap/*/current/.cache/fontconfig \
           "${HOME}"/snap/*/*/.cache/fontconfig 2>/dev/null || true
    if command -v fc-cache >/dev/null 2>&1; then
        fc-cache -f >/dev/null 2>&1 || true
    fi
    if command -v pkill >/dev/null 2>&1; then
        pkill -f "[s]nap-store" >/dev/null 2>&1 || true
    fi

    # 3. Register and activate in GNOME / Ubuntu Input Sources (org.gnome.desktop.input-sources)
    if command -v gsettings >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
        python3 - "${ENGINE_ID}" <<'PYEOF' 2>/dev/null || true
import ast, subprocess, sys
engine_id = sys.argv[1]

def get_sources_list(key):
    try:
        raw = subprocess.check_output(
            ["gsettings", "get", "org.gnome.desktop.input-sources", key],
            stderr=subprocess.DEVNULL
        ).decode().strip()
        if raw.startswith("@a(ss) "):
            raw = raw[len("@a(ss) "):]
        return list(ast.literal_eval(raw)) if raw else []
    except Exception:
        return []

legacy_vn = ("vielotus", "vielotus-vni", "Unikey", "unikey", "bamboo", "Bamboo", "BambooUs")
sources = get_sources_list("sources")
sources = [s for s in sources if not (s[0] == "ibus" and s[1] in legacy_vn) and not (s[0] == "xkb" and s[1] == "vn")]
if not sources:
    sources = [("xkb", "us")]
sources.insert(0, ("ibus", engine_id))
formatted_sources = "[" + ", ".join(f"('{k}', '{v}')" for k, v in sources) + "]"
subprocess.call(
    ["gsettings", "set", "org.gnome.desktop.input-sources", "sources", formatted_sources],
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
)

mru = get_sources_list("mru-sources")
mru = [s for s in mru if not (s[0] == "ibus" and s[1] in legacy_vn) and not (s[0] == "xkb" and s[1] == "vn")]
mru.insert(0, ("ibus", engine_id))
for s in sources:
    if s not in mru:
        mru.append(s)
formatted_mru = "[" + ", ".join(f"('{k}', '{v}')" for k, v in mru) + "]"
subprocess.call(
    ["gsettings", "set", "org.gnome.desktop.input-sources", "mru-sources", formatted_mru],
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
)
subprocess.call(
    ["gsettings", "set", "org.gnome.desktop.input-sources", "current", "0"],
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
)
PYEOF
    fi
}

run_gtk_settings() {
    SMOKE_MODE="${1:-0}"
    python3 - "${CONFIG_FILE}" "${SMOKE_MODE}" <<'GTK_PYEOF'
import os, subprocess, sys, webbrowser

try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib
except Exception:
    sys.exit(2)

ok, _ = Gtk.init_check(sys.argv[:1])
if not ok:
    sys.exit(2)

config_path = sys.argv[1]
smoke_mode = len(sys.argv) > 2 and sys.argv[2] == "1"

cfg = {
    "INPUT_METHOD": "telex",
    "GRAMMAR_PROFILE": "sen_flex",
    "SMART_BILINGUAL": "true",
    "MODERN_ORTHOGRAPHY": "true",
    "QUICK_TELEX": "false",
    "RELAXED_CODA": "false",
    "MACRO_ENABLED": "true",
    "DEVELOPER_MODE": "false",
    "PREEDIT_UNDERLINE": "false",
}
if os.path.exists(config_path):
    with open(config_path, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.strip().split("=", 1)
                cfg[k.strip()] = v.strip().strip('"').strip("'")

# Always-On Smart Engine parity with macOS
cfg["SMART_BILINGUAL"] = "true"
cfg["MODERN_ORTHOGRAPHY"] = "true"

css = b"""
* { font-family: "Noto Sans", "DejaVu Sans", "Liberation Sans", "Ubuntu", sans-serif; }
.bento-win { background-color: #f5f5f7; }
.bento-header { background-color: #ffffff; border-bottom: 1px solid #e5e5ea; padding: 10px 16px; }
.bento-footer { background-color: #ffffff; border-top: 1px solid #e5e5ea; padding: 8px 16px; }
.bento-card { background-color: #ffffff; border: 1px solid #e2e2e8; border-radius: 10px; padding: 10px 12px; }
.bento-card-active { background-color: #ecf5ff; border: 2px solid #007aff; border-radius: 10px; padding: 10px 12px; }
.bento-strip { background-color: #edeefd; border: 1px solid #c6caf8; border-radius: 9px; padding: 8px 12px; }
"""
style_provider = Gtk.CssProvider()
try:
    style_provider.load_from_data(css)
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(
            screen, style_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
except Exception:
    pass

win = Gtk.Window(title="Sen Việt (VieLotusIM) — Cài đặt")
try:
    GLib.set_prgname("vielotus")
    GLib.set_application_name("Sen Việt")
except Exception:
    pass
win.set_default_size(520, 510)
win.set_resizable(False)
win.set_position(Gtk.WindowPosition.CENTER)
win.get_style_context().add_class("bento-win")
try:
    win.set_icon_name("vielotus")
except Exception:
    pass

root_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
win.add(root_vbox)

# 1. Top Header Bar (Matches macOS SettingsView.swift: Brand + 2-Tab Switcher)
header_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
header_bar.get_style_context().add_class("bento-header")

brand_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
title_lbl = Gtk.Label()
title_lbl.set_markup(
    "<span size='large' weight='bold' foreground='#1c1c1e'>🌸 Sen Việt</span> "
    "<span size='small' weight='bold' foreground='#007aff'>v2.0.0</span>"
)
title_lbl.set_xalign(0)
sub_lbl = Gtk.Label()
sub_lbl.set_markup("<span size='small' foreground='#6e6e73'>IBus &amp; Fcitx5 Native • Không quyền Trợ năng</span>")
sub_lbl.set_xalign(0)
brand_vbox.pack_start(title_lbl, False, False, 0)
brand_vbox.pack_start(sub_lbl, False, False, 0)
header_bar.pack_start(brand_vbox, True, True, 0)

stack = Gtk.Stack()
stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
stack.set_transition_duration(120)

stack_switcher = Gtk.StackSwitcher()
stack_switcher.set_stack(stack)
header_bar.pack_end(stack_switcher, False, False, 0)
root_vbox.pack_start(header_bar, False, False, 0)

def save_current_config(*_):
    os.makedirs(os.path.dirname(config_path), exist_ok=True)
    with open(config_path, "w", encoding="utf-8") as f:
        for key in (
            "INPUT_METHOD",
            "GRAMMAR_PROFILE",
            "SMART_BILINGUAL",
            "MODERN_ORTHOGRAPHY",
            "QUICK_TELEX",
            "RELAXED_CODA",
            "MACRO_ENABLED",
            "DEVELOPER_MODE",
            "PREEDIT_UNDERLINE",
        ):
            f.write(f'{key}="{cfg[key]}"\n')
    settings_bin = "/usr/bin/vielotus-settings"
    if not os.path.exists(settings_bin):
        settings_bin = os.path.abspath(sys.argv[0])
    im_flag = "--vni" if cfg["INPUT_METHOD"] == "vni" else "--telex"
    if smoke_mode:
        subprocess.call([settings_bin, im_flag])
    else:
        subprocess.Popen(
            [settings_bin, im_flag],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

# ==============================================================================
# TAB 1: CÀI ĐẶT (Matches macOS 2-Card Hero + 2x2 Bento Grid + Smart Strip)
# ==============================================================================
tab_settings = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
tab_settings.set_border_width(14)

# Section 1 Header
sec1_hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
sec1_left = Gtk.Label()
sec1_left.set_markup("<span size='small' weight='bold' foreground='#6e6e73'>KIỂU GÕ TIẾNG VIỆT</span>")
sec1_left.set_xalign(0)

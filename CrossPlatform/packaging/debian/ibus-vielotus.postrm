#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v ibus >/dev/null 2>&1; then
        rm -f /home/*/.cache/ibus/bus/registry* /root/.cache/ibus/bus/registry* 2>/dev/null || true
        ibus write-cache --system >/dev/null 2>&1 || true
    fi
    rm -f /home/*/.config/fontconfig/conf.d/51-vielotus-vietnamese.conf \
          /home/*/.config/fontconfig/conf.d/99-vielotus-vietnamese.conf \
          /home/*/.config/vielotus/.onboarded 2>/dev/null || true
fi

#DEBHELPER#

exit 0

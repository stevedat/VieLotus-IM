FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Ho_Chi_Minh

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    devscripts \
    debhelper \
    dh-make \
    dpkg-dev \
    fakeroot \
    lintian \
    dput \
    gnupg \
    extra-cmake-modules \
    fcitx5-modules-dev \
    libfcitx5config-dev \
    libfcitx5core-dev \
    libfcitx5utils-dev \
    libibus-1.0-dev \
    libglib2.0-dev \
    python3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create dput config for PPA and Debian Mentors
RUN mkdir -p /root && printf '[vielotus-ppa]\nfqdn = ppa.launchpad.net\nmethod = ftp\nincoming = ~stevedat/vielotus/ubuntu/\nlogin = anonymous\nallow_unsigned_uploads = 0\n\n[mentors]\nfqdn = mentors.debian.net\nincoming = /upload\nmethod = https\nallow_unsigned_uploads = 0\nprogress_indicator = 2\n' > /root/.dput.cf

WORKDIR /build

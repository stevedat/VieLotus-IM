<?xml version="1.0" encoding="utf-8"?>
<!--
    VieLotusIM (Sen Việt) - IBus Component Specification
    Pure Native Vietnamese Input Method Engine
-->
<component>
    <name>org.freedesktop.IBus.VieLotus</name>
    <description>VieLotusIM (Sen Việt) Vietnamese Input Method</description>
    <version>2.0.0</version>
    <author>Trần Phát Đạt (Steve Dat)</author>
    <homepage>https://github.com/stevedat/VieLotus-IM</homepage>
    <license>MIT</license>
    <exec>@LIBEXECDIR@/ibus-engine-vielotus --ibus</exec>
    <textdomain>ibus-vielotus</textdomain>
    <observed-paths>
        <path>@LIBEXECDIR@/ibus-engine-vielotus</path>
    </observed-paths>
    <engines>
        <engine>
            <name>vielotus</name>
            <longname>Sen Việt - Telex</longname>
            <description>Bộ gõ tiếng Việt Sen Việt thế hệ mới (Telex)</description>
            <language>vi</language>
            <license>MIT</license>
            <author>Trần Phát Đạt (Steve Dat)</author>
            <icon>vielotus</icon>
            <layout>us</layout>
            <rank>99</rank>
            <symbol>🇻🇳</symbol>
            <setup>/usr/bin/vielotus-settings</setup>
        </engine>
        <engine>
            <name>vielotus-vni</name>
            <longname>Sen Việt - VNI</longname>
            <description>Bộ gõ tiếng Việt Sen Việt thế hệ mới (VNI)</description>
            <language>vi</language>
            <license>MIT</license>
            <author>Trần Phát Đạt (Steve Dat)</author>
            <icon>vielotus</icon>
            <layout>us</layout>
            <rank>98</rank>
            <symbol>🇻🇳</symbol>
            <setup>/usr/bin/vielotus-settings</setup>
        </engine>
    </engines>
</component>

# VieLotusIM — benchmark ratchet floors
# ============================================================================
# Managed by scripts/benchmark_ratchet.sh. Do not edit by hand to make a failure
# go away.
#
# Ratchet rule: a floor only ever moves UP. `benchmark_ratchet.sh --ratchet`
# rewrites this file with the worst-of-N measured value truncated toward zero
# (never rounded up, so a floor can never sit above the measurement it came
# from). A run that measures worse than a floor fails the build; it never
# lowers the floor.
#
# Baseline measured 2026-10-11, release build, after two harness fixes:
#   1. per-row context isolation — InputSessionManager.reset() does NOT clear
#      `context`, so rows used to inherit "he is" from an earlier primed row.
#      Fixing that moved overall from 99.99% to 99.96% and exposed `gif`/`gis`
#      as genuine restore_raw misses.
#   2. the symmetric `vn_survives_collision` bucket — see below.
# ============================================================================

# --- Headline accuracy (existing buckets) -----------------------------------
OVERALL_FLOOR=99.96
TRANSFORM_FLOOR=100.00
RESTORE_RAW_FLOOR=99.95
KEEP_AS_TYPED_FLOOR=100.00
AMBIGUOUS_NEEDS_CONTEXT_FLOOR=100.00
CANCEL_KEEP_COMPOSED_FLOOR=100.00

# --- Symmetric ambiguous buckets (the cost side of Smart Bilingual) ----------
# vn_survives_collision: the lowercase `ambiguous_needs_context` rows replayed
# with NO English context, expecting the Vietnamese syllable. 322/373.
# ambiguous_both_sides: the subset that is correct on BOTH sides — English when
# a context is primed AND Vietnamese when it is not. This is the number worth
# quoting; either half alone overstates the engine.
VN_SURVIVES_COLLISION_FLOOR=86.32
AMBIGUOUS_BOTH_SIDES_FLOOR=86.32

# case_signal_restores: the 674 `case_variant` rows replayed with no context,
# expecting capitalisation alone to restore English. Gated as a ratchet (it must
# not regress) but NOT a quality target — whether capitalisation alone *should*
# restore English without a context is an undecided product policy.
CASE_SIGNAL_RESTORES_FLOOR=9.79

# --- Keystroke latency ceilings & throughput (stress & endurance) ------------
# p99 latency ceilings in microseconds (µs) — lower is better. Gate fails if
# measured p99 exceeds ceiling. Throughput floor in keystrokes/sec (KPS) — higher
# is better.
TELEX_P99_CEILING=500.00
VNI_P99_CEILING=300.00
MIXED_P99_CEILING=700.00
THROUGHPUT_FLOOR_KPS=25000.00


